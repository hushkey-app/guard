package components

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/card"
)

// Toolbar is the dashboard's one shared control: a time range that overrides
// every panel's saved window at once.
//
// It overrides rather than replaces. A panel saved as "last 7 days" next to
// fifteen hourly ones is a deliberate thing to build, so leaving this on
// "As saved" leaves each panel's own window alone — see contract.ViewDataQuery.
templ Toolbar() {
	@card.Card(card.Props{Size: card.SizeSm}) {
		@card.Content() {
			<div class="flex flex-wrap items-end justify-between gap-3">
				@BuilderSelect("dashboard_range", "Time range", "min-w-48") {
					<option value="" selected>As each panel was saved</option>
					<option value="15m">Last 15 minutes</option>
					<option value="1h">Last hour</option>
					<option value="6h">Last 6 hours</option>
					<option value="24h">Last 24 hours</option>
					<option value="7d">Last 7 days</option>
					<option value="all">All retained</option>
				}
				<div class="flex items-center gap-2">
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Size:       button.SizeSm,
						Attributes: templ.Attributes{"data-views-refresh": true},
					}) {
						Refresh
					}
					@button.Button(button.Props{
						Size:       button.SizeSm,
						Attributes: templ.Attributes{"data-builder-open": "new"},
					}) {
						+ New panel
					}
				</div>
			</div>
		}
	}
}
