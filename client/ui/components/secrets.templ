// Package components — the secrets surface: the environments, the pairs in
// them, and the keys applications hold.
//
// Three panels on one page, because configuring this is one job. An environment
// with no secrets configures nothing, a secret nothing can read is a value in a
// database, and a key with no environment cannot exist — splitting them across
// routes would mean nobody can finish the task without navigating twice.
//
// The layout is a list, like /cluster and /storage: one line per secret, keys
// in a fixed column so they line up down the page, values masked until asked
// for. What guard hands out here it hands out through `guard-vault`, which is a
// different process on the same database — this page only writes.
package components

import "github.com/axadrn/shadcn-templ/v2/components/button"

// SecretsPanel is the whole surface: the environments down the left, the pairs
// on the right, and the keys under both.
templ SecretsPanel() {
	<div class="space-y-6">
		<p data-secret-status class="hidden rounded-lg border border-destructive/40 bg-destructive/10 p-3 text-sm text-destructive"></p>
		<div class="grid items-start gap-6 lg:grid-cols-[16rem_minmax(0,1fr)]">
			@secretEnvs()
			@secretValues()
		</div>
		@secretKeys()
		@secretImport()
		@secretToken()
	</div>
	@secretRowTemplate()
	@secretKeyRowTemplate()
}

// secretEnvs is the left column: one line per environment, with what is in it.
templ secretEnvs() {
	<aside class="lg:sticky lg:top-24">
		<div class="rounded-xl border border-border bg-card text-card-foreground">
			<div class="flex items-center justify-between gap-2 border-b border-border px-4 py-3">
				<p class="text-[.68rem] font-semibold uppercase tracking-[.18em] text-muted-foreground">Environments</p>
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeIconSm,
					Class:      "text-muted-foreground",
					Attributes: templ.Attributes{"data-env-add": true, "aria-label": "Add an environment", "title": "Add an environment"},
				}) {
					+
				}
			</div>
			<div data-secret-envs class="divide-y divide-border"></div>
		</div>
		<p class="mt-3 px-1 text-xs leading-relaxed text-muted-foreground">
			A group is a name and nothing else — no projects, no inheritance. Two apps
			that must not share production are two groups.
		</p>
	</aside>
}

// secretValues is the table, and the four buttons over it.
templ secretValues() {
	<div class="min-w-0 space-y-4">
		<div class="rounded-xl border border-border bg-card text-card-foreground">
			<div class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-5 py-4">
				<div class="min-w-0">
					<p data-secret-env-name class="truncate text-sm font-semibold">…</p>
					<p data-secret-env-note class="text-xs text-muted-foreground"></p>
				</div>
				<div class="flex flex-wrap items-center gap-2">
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Size:       button.SizeSm,
						Attributes: templ.Attributes{"data-secret-reveal-all": true, "title": "Show every value on this page"},
					}) {
						Show values
					}
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Size:       button.SizeSm,
						Attributes: templ.Attributes{"data-secret-export": true, "title": "Copy this environment as .env text"},
					}) {
						Copy .env
					}
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Size:       button.SizeSm,
						Attributes: templ.Attributes{"data-secret-import-open": true},
					}) {
						Import .env
					}
					@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"data-secret-add": true}}) {
						Add secret
					}
				</div>
			</div>
			<div data-secret-rows class="divide-y divide-border"></div>
			<p data-secret-empty hidden class="px-5 py-6 text-sm text-muted-foreground">
				Nothing in this environment yet. Add one, or paste a whole .env file with Import.
			</p>
		</div>
	</div>
}

// secretRowTemplate is one pair: the key, the value, and the two presses that
// act on it.
//
// The value is masked until somebody asks. Not because reading it is forbidden
// — this is the page for reading it — but because a screen full of live
// credentials is a screenshot, a shoulder and a screen share waiting to happen,
// and the person who came to change ONE value should not have to expose forty.
templ secretRowTemplate() {
	<template data-secret-row-template>
		<div data-secret-id class="flex flex-wrap items-center gap-x-3 gap-y-2 px-5 py-3 hover:bg-muted/30">
			<input data-secret-key spellcheck="false" autocomplete="off" placeholder="DATABASE_URL" class="cn-input h-8 w-full font-mono text-xs sm:w-64"/>
			<input data-secret-value type="password" spellcheck="false" autocomplete="new-password" placeholder="value" class="cn-input h-8 min-w-0 flex-1 font-mono text-xs"/>
			<span data-secret-unreadable hidden class="cn-badge cn-badge-variant-destructive shrink-0 whitespace-nowrap" title="This was sealed with a different key — set it again">
				unreadable
			</span>
			<span data-secret-updated class="hidden w-24 shrink-0 text-[.6rem] text-muted-foreground md:block"></span>
			<div class="ml-auto flex shrink-0 items-center gap-1">
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeIconSm,
					Class:      "text-muted-foreground",
					Attributes: templ.Attributes{"data-secret-show": true, "aria-label": "Show this value", "title": "Show this value"},
				}) {
					@iconEye()
				}
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeIconSm,
					Class:      "text-muted-foreground",
					Attributes: templ.Attributes{"data-secret-copy": true, "aria-label": "Copy this value", "title": "Copy this value"},
				}) {
					@iconCopy()
				}
				@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"data-secret-save": true}}) {
					Save
				}
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeIconSm,
					Class:      "text-muted-foreground hover:text-destructive",
					Attributes: templ.Attributes{"data-secret-remove": true, "aria-label": "Delete this secret"},
				}) {
					@iconTrash()
				}
			</div>
		</div>
	</template>
}

// secretImport is the paste.
//
// A modal rather than a panel on the page: pasting a file is one transaction
// with a beginning and an end, the rows behind it are not part of it, and the
// thing being pressed can delete forty values. A native <dialog>, like the
// confirm — the shadcn one needs the JS bundle guard does not serve.
//
// It reports before it writes: the same call runs with dry_run first, and what
// it says is what the second call does. A bulk write that reports one number
// afterwards is a bulk write people do not press.
templ secretImport() {
	<!-- Centred by a rule in app.css, not by a utility: the stylesheet's base
	     margin for block elements outranks m-auto, and a modal in the top-left
	     corner is what that costs. -->
	<dialog data-secret-import class="max-h-[calc(100dvh-3rem)] w-[min(46rem,calc(100vw-2rem))] overflow-auto rounded-xl border border-border bg-card p-0 text-card-foreground shadow-2xl backdrop:bg-black/60">
		<div class="p-6">
			<div class="flex flex-wrap items-baseline justify-between gap-3">
				<div>
					<p class="text-sm font-semibold">Import .env</p>
					<p class="text-xs text-muted-foreground">
						Paste a whole file. <code class="font-mono">export</code> prefixes, comments and
						quotes are understood, and a quoted value may run over several lines — which is
						how a private key ends up in one of these.
					</p>
				</div>
				<label class="flex items-center gap-2 text-xs text-muted-foreground">
					<input data-secret-import-prune type="checkbox" class="cn-checkbox size-4"/>
					Delete keys the file does not mention
				</label>
			</div>
			<!-- Big on purpose. This box is what the dialog is for: a whole
			     file goes in it, and a paste target the size of a search field
			     reads as "type a line here", which is not the job. Twenty rem
			     shows about twenty-five lines — enough to see what you pasted
			     and scroll the rest.
			     min-h, not rows: cn-input sets a fixed height for one-line
			     fields and it beats the rows attribute, which left this box
			     exactly one line tall. min-height wins over height whatever the
			     source order, which is why it is the one that works here. -->
			<textarea data-secret-import-text rows="20" spellcheck="false" placeholder="DATABASE_URL=postgres://…&#10;API_TOKEN=…&#10;PRIVATE_KEY=&#34;-----BEGIN…&#34;" class="cn-input mt-4 min-h-80 w-full resize-y p-3 font-mono text-xs"></textarea>
			<div data-secret-import-report hidden class="mt-3 space-y-2 rounded-lg border border-border bg-background/40 p-3 text-xs"></div>
			<div class="mt-4 flex flex-wrap items-center justify-end gap-3">
				<span data-secret-import-status class="mr-auto text-sm text-muted-foreground empty:hidden"></span>
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Size:       button.SizeSm,
					Attributes: templ.Attributes{"data-secret-import-cancel": true},
				}) {
					Close
				}
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Size:       button.SizeSm,
					Attributes: templ.Attributes{"data-secret-import-check": true},
				}) {
					What would this do?
				}
				@button.Button(button.Props{
					Size:       button.SizeSm,
					Attributes: templ.Attributes{"data-secret-import-apply": true},
				}) {
					Import
				}
			</div>
		</div>
	</dialog>
}

// secretKeys is what the applications hold.
templ secretKeys() {
	<div class="rounded-xl border border-border bg-card text-card-foreground">
		<div class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-5 py-4">
			<div>
				<p class="text-sm font-semibold">Access keys</p>
				<p class="text-xs text-muted-foreground">
					One key reads one environment, from <code class="font-mono">guard-vault</code> —
					a second process on this database, so a bad guard release cannot stop a
					container from booting.
				</p>
			</div>
			@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"data-key-add": true}}) {
				New key
			}
		</div>
		<div data-secret-keys class="divide-y divide-border"></div>
		<p data-secret-keys-empty hidden class="px-5 py-6 text-sm text-muted-foreground">
			No keys yet. Nothing can read these secrets over HTTP until one exists.
		</p>
	</div>
}

templ secretKeyRowTemplate() {
	<template data-secret-key-row-template>
		<div data-key-id class="flex flex-wrap items-center gap-x-4 gap-y-2 px-5 py-3">
			<div class="flex min-w-0 flex-1 flex-col gap-0.5">
				<div class="flex min-w-0 items-center gap-2">
					<p data-key-name class="truncate font-medium"></p>
					<span data-key-env class="cn-badge cn-badge-variant-secondary shrink-0 whitespace-nowrap"></span>
					<span data-key-revoked hidden class="cn-badge cn-badge-variant-destructive shrink-0 whitespace-nowrap">revoked</span>
				</div>
				<p data-key-prefix class="truncate font-mono text-xs text-muted-foreground"></p>
			</div>
			<div class="hidden w-32 shrink-0 flex-col md:flex">
				<p class="text-[.6rem] uppercase tracking-[.14em] text-muted-foreground">Last used</p>
				<p data-key-used class="text-sm"></p>
			</div>
			@button.Button(button.Props{
				Variant:    button.VariantGhost,
				Size:       button.SizeSm,
				Class:      "shrink-0 text-muted-foreground hover:text-destructive",
				Attributes: templ.Attributes{"data-key-revoke": true},
			}) {
				Revoke
			}
		</div>
	</template>
}

// secretToken is the one moment a token exists on this side of the wire.
//
// Its own panel rather than a line in the list, because it is the only thing
// on the page that cannot be looked up again: guard kept the hash. Somebody who
// closes this without copying is minting another one.
templ secretToken() {
	<div data-secret-token hidden>
		<div class="rounded-xl border border-primary/40 bg-primary/5 p-5">
			<p class="text-sm font-semibold">Copy this key now</p>
			<p class="mt-1 text-xs text-muted-foreground">
				It is not stored — only a hash of it is — so this is the last time guard can
				show it. Losing it means making another one, which is the point.
			</p>
			<div class="mt-3 flex items-center gap-2">
				<code data-secret-token-value class="min-w-0 flex-1 truncate rounded bg-muted/60 px-3 py-2 font-mono text-xs"></code>
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Size:       button.SizeSm,
					Attributes: templ.Attributes{"data-secret-token-copy": true},
				}) {
					Copy
				}
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeSm,
					Class:      "text-muted-foreground",
					Attributes: templ.Attributes{"data-secret-token-done": true},
				}) {
					Done
				}
			</div>
		</div>
	</div>
}

// iconEye is the show/hide control. Drawn here rather than pulled from an icon
// package for the same reason iconTrash and iconCopy are: two paths are not a
// dependency.
templ iconEye() {
	<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z"></path>
		<circle cx="12" cy="12" r="3"></circle>
	</svg>
}
