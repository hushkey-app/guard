// Package components — the alerts surface: where events go, and the rules that
// send them there.
//
// Two lists on one page on purpose. A destination with no rule sends nothing
// and a rule with no destination cannot exist, so keeping them apart would mean
// a feature nobody can finish configuring without navigating twice.
package components

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/hushkey-app/guard/internal/telemetry/model"
)

// WebhookList is the destinations: name, where, and whether a token is stored.
templ WebhookList() {
	<div data-webhooks class="space-y-4">
		<div class="rounded-xl border border-border bg-card text-card-foreground">
			<div class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-5 py-4">
				<div>
					<p class="text-sm font-semibold">Destinations</p>
					<p class="text-xs text-muted-foreground">
						One POST of JSON per event. A Slack or Discord incoming webhook needs no
						token — the URL is the secret; anything else usually wants one.
					</p>
				</div>
				@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"data-webhook-add": true}}) {
					Add destination
				}
			</div>
			<div data-webhook-rows class="divide-y divide-border"></div>
			<p data-webhook-empty class="px-5 py-6 text-sm text-muted-foreground">
				Nothing configured. Events are written to guard's log and nowhere else.
			</p>
		</div>
	</div>
	<template data-webhook-row-template>
		<div data-webhook class="space-y-3 px-5 py-4">
			<div class="grid gap-2 sm:grid-cols-[minmax(0,12rem)_minmax(0,1fr)] sm:items-center">
				<input data-webhook-field="name" maxlength="60" placeholder="Ops channel" class="cn-input h-8 text-xs"/>
				<input data-webhook-field="url" spellcheck="false" placeholder="https://hooks.slack.com/services/…" class="cn-input h-8 font-mono text-xs"/>
			</div>
			<div class="flex flex-wrap items-center gap-2">
				<input data-webhook-field="token" type="password" placeholder="token (optional)" autocomplete="new-password" class="cn-input h-8 w-56 font-mono text-xs"/>
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeSm,
					Class:      "text-muted-foreground",
					Attributes: templ.Attributes{"data-webhook-change": true, "hidden": true},
				}) {
					Change
				}
				<input data-webhook-field="header" maxlength="60" placeholder="Authorization" title="The header the token goes in. Empty means Authorization, where a bare token becomes a Bearer credential." class="cn-input h-8 w-40 font-mono text-xs"/>
				<span data-webhook-state class="text-[.65rem] text-muted-foreground empty:hidden"></span>
				<div class="ml-auto flex items-center gap-1">
					@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"data-webhook-test": true}}) {
						Test
					}
					@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"data-webhook-save": true}}) {
						Save
					}
					@button.Button(button.Props{
						Variant:    button.VariantGhost,
						Size:       button.SizeIconSm,
						Class:      "text-muted-foreground hover:text-destructive",
						Attributes: templ.Attributes{"data-webhook-remove": true, "aria-label": "Remove this destination"},
					}) {
						@iconTrash()
					}
				</div>
			</div>
		</div>
	</template>
}

// MonitorList is the rules: which machine, which measurement, which way, how
// far, for how long, and where to say so.
templ MonitorList() {
	<div data-monitors class="space-y-4">
		<div class="rounded-xl border border-border bg-card text-card-foreground">
			<div class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-5 py-4">
				<div>
					<p class="text-sm font-semibold">Rules</p>
					<p class="text-xs text-muted-foreground">
						Every measurement here is one the cluster page already shows. A rule adds a
						comparison and a POST — never a second source of truth.
					</p>
				</div>
				@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"data-monitor-add": true}}) {
					Add rule
				}
			</div>
			<div data-monitor-rows class="divide-y divide-border"></div>
			<p data-monitor-empty class="px-5 py-6 text-sm text-muted-foreground">
				No rules yet. Nothing about a machine's CPU, memory, disk or health will be sent
				anywhere.
			</p>
		</div>
	</div>
	<template data-monitor-row-template>
		<div data-monitor class="space-y-3 px-5 py-4">
			<div class="flex flex-wrap items-center gap-2">
				<select data-monitor-field="node" class="cn-native-select h-8 w-40 text-xs" aria-label="Machine"></select>
				<select data-monitor-field="metric" class="cn-native-select h-8 w-48 text-xs" aria-label="Measurement"></select>
				<select data-monitor-field="op" class="cn-native-select h-8 w-24 text-xs" aria-label="Direction">
					<option value="above">above</option>
					<option value="below">below</option>
				</select>
				<label class="flex items-center gap-1 text-[.65rem] text-muted-foreground">
					<input data-monitor-field="threshold" type="number" step="any" class="cn-input h-8 w-24 text-xs"/>
					<span data-monitor-unit></span>
				</label>
				<label class="flex items-center gap-1 text-[.65rem] text-muted-foreground">
					for
					<input data-monitor-field="for" type="number" min="0" step="1" placeholder="5" class="cn-input h-8 w-20 text-xs"/>
					min
				</label>
				<select data-monitor-field="webhook" class="cn-native-select h-8 w-44 text-xs" aria-label="Destination"></select>
			</div>
			<div class="flex flex-wrap items-center gap-3">
				<label class="flex items-center gap-2 text-xs text-muted-foreground">
					<input data-monitor-field="enabled" type="checkbox" class="size-3.5 accent-primary"/>
					enabled
				</label>
				<span data-monitor-state class="text-[.65rem] text-muted-foreground empty:hidden"></span>
				<div class="ml-auto flex items-center gap-1">
					@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"data-monitor-save": true}}) {
						Save
					}
					@button.Button(button.Props{
						Variant:    button.VariantGhost,
						Size:       button.SizeIconSm,
						Class:      "text-muted-foreground hover:text-destructive",
						Attributes: templ.Attributes{"data-monitor-remove": true, "aria-label": "Remove this rule"},
					}) {
						@iconTrash()
					}
				</div>
			</div>
		</div>
	</template>
	<!-- The vocabulary, rendered once from the server's own list so the form
	     cannot offer a metric guard does not measure. -->
	<template data-metric-options>
		for _, metric := range model.MonitorMetrics {
			<option
				value={ metric.Key }
				data-unit={ metric.Unit }
				data-op={ metric.Op }
				data-category={ metric.Category }
				data-state={ boolAttr(metric.State) }
			>{ metric.Label }</option>
		}
	</template>
}

func boolAttr(value bool) string {
	if value {
		return "1"
	}
	return ""
}
