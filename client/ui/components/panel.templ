package components

import (
	"github.com/axadrn/shadcn-templ/v2/components/badge"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/empty"
)

// Grid is the dashboard. Twelve columns on a wide screen, one on a narrow one,
// with each panel's span set from its stored width.
templ Grid() {
	<div data-view-grid class="grid grid-cols-1 gap-4 lg:grid-cols-12"></div>
}

// GridEmpty is what a new instance looks like: no panels, and the one thing to
// do about it.
templ GridEmpty() {
	<div data-view-empty>
		@empty.Empty(empty.Props{Class: "min-h-64 border border-dashed border-border"}) {
			@empty.Header() {
				@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
					◫
				}
				@empty.Title() {
					No panels yet
				}
				@empty.Description() {
					A panel is a saved question — filter some telemetry, group it, pick how to draw it.
				}
			}
			@empty.Content() {
				<div class="flex flex-wrap items-center justify-center gap-2">
					@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"data-builder-open": "new"}}) {
						Build the first panel
					}
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Size:       button.SizeSm,
						Attributes: templ.Attributes{"data-views-samples": true},
					}) {
						Add one of each
					}
				</div>
			}
		}
	</div>
}

// PanelTemplate is the card every panel is cloned from.
//
// The slots, which client/public/views.js fills:
//
//	data-panel            the article, carrying data-panel-id and the grid span
//	data-panel-title      the view's name
//	data-panel-meta       what it is measuring, in words
//	data-panel-body       where the renderer draws
//	data-panel-legend     series swatches, empty for panels with one series
//	data-panel-notes      what the query had to truncate, if anything
//	data-panel-error      why it did not render, if it did not
templ PanelTemplate() {
	<template data-panel-template>
		<article data-panel class="min-w-0">
			@card.Card(card.Props{Class: "h-full gap-3"}) {
				@card.Header() {
					@card.Title(card.TitleProps{Class: "truncate text-base"}) {
						<span data-panel-title>Panel</span>
					}
					@card.Description(card.DescriptionProps{Class: "truncate"}) {
						<span data-panel-meta></span>
					}
					@card.Action() {
						<div class="flex items-center gap-1">
							<!-- draggable sits on the handle, not on the card:
							     a whole panel that drags from anywhere cannot
							     also be a panel you select text in. The button
							     is real so it can be tabbed to and moved with
							     the arrow keys — a handle that only answers to
							     a mouse is a layout keyboard users cannot
							     change. -->
							@button.Button(button.Props{
								Variant: button.VariantGhost,
								Size:    button.SizeIconSm,
								Class:   "cursor-grab text-muted-foreground active:cursor-grabbing",
								Attributes: templ.Attributes{
									"data-panel-drag": true,
									"draggable":       "true",
									"aria-label":      "Reorder panel — drag, or use the arrow keys",
									"title":           "Drag to reorder · ← → with the keyboard",
								},
							}) {
								@iconGrip()
							}
							@button.Button(button.Props{
								Variant:    button.VariantGhost,
								Size:       button.SizeIconSm,
								Attributes: templ.Attributes{"data-panel-edit": true, "aria-label": "Edit panel", "title": "Edit"},
							}) {
								@iconPencil()
							}
							@button.Button(button.Props{
								Variant:    button.VariantGhost,
								Size:       button.SizeIconSm,
								Class:      "text-muted-foreground hover:text-destructive",
								Attributes: templ.Attributes{"data-panel-delete": true, "aria-label": "Delete panel", "title": "Delete"},
							}) {
								@iconTrash()
							}
						</div>
					}
				}
				@card.Content(card.ContentProps{Class: "flex min-h-0 flex-1 flex-col gap-3"}) {
					<div data-panel-body class="min-h-0 flex-1"></div>
					<div data-panel-legend class="flex flex-wrap gap-x-4 gap-y-1"></div>
					<p data-panel-notes class="text-xs text-muted-foreground empty:hidden"></p>
					<p data-panel-error class="text-xs text-destructive empty:hidden"></p>
				}
			}
		</article>
	</template>
}

// PanelBodies are the bodies a panel can have, one per shape, cloned by name.
//
// The chart shapes are one SVG host — a line, a bar and a heatmap differ in
// what is drawn into the box, not in the box. The single-value shapes are not
// drawings at all, so they are markup with slots: a stat is a number and a
// delta, a bar gauge is a track and a fill whose width is a percentage, a gauge
// is an arc whose dash offset is one. Building those three in JavaScript would
// mean three more places for the theme to be approximated.
templ PanelBodies() {
	<template data-panel-body-template="chart">
		<div data-chart class="h-full min-h-56 w-full"></div>
	</template>
	<template data-panel-body-template="stat">
		<div class="flex h-full flex-col justify-center py-2">
			<p data-stat-value class="text-4xl font-semibold tabular-nums tracking-tight">—</p>
			<p class="mt-2 flex items-center gap-2 text-xs">
				<span data-stat-delta class="font-medium tabular-nums"></span>
				<span data-stat-caption class="text-muted-foreground"></span>
			</p>
			<div data-stat-spark class="mt-3 h-10 w-full"></div>
		</div>
	</template>
	<template data-panel-body-template="bar_gauge">
		<div class="flex h-full flex-col justify-center gap-3 py-2">
			<div class="flex items-baseline justify-between gap-3">
				<span data-stat-value class="text-3xl font-semibold tabular-nums">—</span>
				<span data-gauge-max class="font-mono text-xs text-muted-foreground"></span>
			</div>
			<div class="h-3 w-full overflow-hidden rounded-full bg-muted">
				<div data-gauge-fill class="h-full rounded-full bg-primary transition-[width] duration-300" style="width:0%"></div>
			</div>
			<p data-stat-caption class="text-xs text-muted-foreground"></p>
		</div>
	</template>
	<template data-panel-body-template="gauge">
		<div class="flex h-full flex-col items-center justify-center py-2">
			<svg viewBox="0 0 120 72" class="w-full max-w-56" role="img" aria-label="Gauge">
				<!-- Two arcs on the same path: the track, and the value drawn
				     over it by shortening its dash. -->
				<path d="M10 66 A 50 50 0 0 1 110 66" fill="none" stroke="currentColor" stroke-width="10" stroke-linecap="round" class="text-muted"></path>
				<path data-gauge-arc d="M10 66 A 50 50 0 0 1 110 66" fill="none" stroke="currentColor" stroke-width="10" stroke-linecap="round" class="text-primary transition-[stroke-dashoffset] duration-300" stroke-dasharray="157" stroke-dashoffset="157"></path>
			</svg>
			<p data-stat-value class="-mt-4 text-3xl font-semibold tabular-nums">—</p>
			<p data-stat-caption class="mt-1 text-xs text-muted-foreground"></p>
		</div>
	</template>
	<template data-panel-body-template="waterfall">
		<div class="flex h-full min-h-56 flex-col gap-2">
			<div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
				<span data-trace-id class="font-mono"></span>
				<span data-trace-duration class="font-medium text-foreground"></span>
				<span data-trace-services></span>
			</div>
			<div data-waterfall class="min-h-0 flex-1 overflow-y-auto"></div>
		</div>
	</template>
}

// Tooltip is the hover layer every chart shares — one element per document,
// moved and refilled rather than created per mark.
//
// It replaced SVG <title> children, which cost nothing but appear a second
// late, cannot be styled, and cannot say "217 events · click to list them".
// The <title> is still written for readers that never move a pointer.
//
// pointer-events-none is load-bearing: the tooltip follows the cursor and would
// otherwise sit under it, taking the pointerleave that dismisses it and
// flickering forever.
templ Tooltip() {
	<div
		data-chart-tooltip
		class="pointer-events-none fixed left-0 top-0 z-[60] hidden min-w-44 max-w-72 rounded-lg border border-border bg-popover/95 p-3 text-xs text-popover-foreground shadow-xl backdrop-blur-sm"
		role="tooltip"
		aria-hidden="true"
	>
		<p data-tooltip-title class="mb-1.5 truncate font-medium"></p>
		<div data-tooltip-rows class="space-y-1"></div>
		<p data-tooltip-hint class="mt-2 hidden border-t border-border pt-1.5 text-[.65rem] text-muted-foreground"></p>
	</div>
}

// DrillRow is one event in the drawer's list, when the drawer is showing what
// is behind a mark rather than one event's detail.
templ DrillRow() {
	<template data-drill-row-template>
		<button type="button" data-drill-row class="flex w-full items-center gap-3 border-b border-border px-1 py-2 text-left hover:bg-accent/60 focus:bg-accent focus:outline-none">
			<span data-drill-time class="shrink-0 font-mono text-[.65rem] text-muted-foreground"></span>
			<span data-drill-badge class="cn-badge inline-flex w-fit shrink-0 items-center justify-center whitespace-nowrap"></span>
			<span data-drill-text class="min-w-0 flex-1 truncate text-xs"></span>
			<span data-drill-value class="shrink-0 font-mono text-[.65rem] tabular-nums text-muted-foreground"></span>
		</button>
	</template>
}

// LegendSwatch is one series in a legend: the colour the renderer used, and the
// key it stands for.
templ LegendSwatch(colour, label string) {
	<span class="inline-flex items-center gap-2 text-xs text-muted-foreground">
		<span class="size-2 shrink-0 rounded-full" style={ "background:" + colour }></span>
		<span class="truncate">{ label }</span>
	</span>
}

// SpanRow is one bar of a waterfall: the label column, then the track the bar
// is positioned in. Offset and width are percentages of the whole trace, so a
// span that took 4% of a request is 4% of the width — the same proportional
// reading a browser's network panel gives.
templ SpanRow() {
	<template data-span-row-template>
		<div data-span class="group flex items-center gap-2 rounded-md px-1 py-[3px] hover:bg-accent/60">
			<div data-span-label class="flex min-w-0 shrink-0 items-center gap-1.5" style="width:38%">
				<span data-span-indent class="shrink-0"></span>
				<span data-span-dot class="size-1.5 shrink-0 rounded-full"></span>
				<span data-span-name class="truncate text-xs"></span>
				<span data-span-service class="shrink-0 truncate font-mono text-[.6rem] text-muted-foreground"></span>
			</div>
			<div class="relative h-4 min-w-0 flex-1 rounded-sm bg-muted/40">
				<div data-span-bar class="absolute inset-y-0 rounded-sm" style="left:0%;width:100%"></div>
			</div>
			<span data-span-duration class="w-16 shrink-0 text-right font-mono text-[.65rem] tabular-nums text-muted-foreground"></span>
		</div>
	</template>
}

// TraceCard is the waterfall on the traces page — the same renderer as the
// waterfall panel, in a card of its own above the span table, showing whichever
// trace was last opened.
templ TraceCard() {
	<div data-trace-card hidden>
		@card.Card(card.Props{Class: "gap-3"}) {
			@card.Header() {
				@card.Title(card.TitleProps{Class: "text-base"}) {
					Trace timeline
				}
				@card.Description() {
					<span data-trace-id class="font-mono"></span>
				}
				@card.Action() {
					<div class="flex items-center gap-2">
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Attributes: templ.Attributes{"data-trace-duration": true}}) {
							—
						}
						@button.Button(button.Props{
							Variant:    button.VariantGhost,
							Size:       button.SizeIconSm,
							Attributes: templ.Attributes{"data-trace-close": true, "aria-label": "Hide the timeline"},
						}) {
							✕
						}
					</div>
				}
			}
			@card.Content() {
				<p data-trace-services class="mb-2 text-xs text-muted-foreground"></p>
				<div data-waterfall class="max-h-[26rem] overflow-y-auto"></div>
			}
		}
	</div>
}

templ iconGrip() {
	<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="currentColor">
		<circle cx="9" cy="6" r="1.6"></circle>
		<circle cx="15" cy="6" r="1.6"></circle>
		<circle cx="9" cy="12" r="1.6"></circle>
		<circle cx="15" cy="12" r="1.6"></circle>
		<circle cx="9" cy="18" r="1.6"></circle>
		<circle cx="15" cy="18" r="1.6"></circle>
	</svg>
}

templ iconPencil() {
	<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
		<path d="M12 20h9"></path>
		<path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
	</svg>
}

templ iconTrash() {
	<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
		<path d="M3 6h18"></path>
		<path d="M8 6V4h8v2"></path>
		<path d="M19 6l-1 14H6L5 6"></path>
	</svg>
}
