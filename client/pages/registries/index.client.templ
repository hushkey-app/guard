package registries

import (
	"github.com/axadrn/shadcn-templ/v2/components/alert"
	"github.com/hushkey-app/guard/client/lifecycle"
	"github.com/hushkey-app/guard/client/ui"
	"github.com/hushkey-app/guard/client/ui/components"
)

templ Head() {
	<title>Registries — Guard</title>
	<meta name="description" content="Explore the container registries your stored keys unlock: repositories, tags, and what each is costing in storage."/>
}

templ Page() {
	<section class="space-y-6">
		@ui.PageHeading("Infrastructure", "Registries", "The container registries your stored keys unlock — read live from the provider, so what you see is what is stored right now.")
		@components.RegistryExplorer()
		@components.ConfirmDialog()
		@alert.Alert() {
			@alert.Title() {
				Where the credentials live
			}
			@alert.Description() {
				Guard stores one account API key per provider account, sealed like the SSH
				passwords, and every request here is made from the server — the browser never
				holds a credential. Add or remove keys under Settings → Cloud accounts.
				Deleting a tag removes the image behind it, so every tag sharing that digest
				goes too, and deleting a registry takes every repository in it and the
				subscription behind them. Only accounts whose provider can order a registry
				are offered one: a managed registry that comes with the account is not a thing
				guard can create or cancel.
			}
		}
	</section>
}

func Mount()   { lifecycle.Mount("registries") }
func Unmount() { lifecycle.Unmount("registries") }
