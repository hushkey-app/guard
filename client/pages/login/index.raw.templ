package login

// The login page, and the only page in guard that is not inside the dashboard.
//
// It is a `.raw` route, which means no document shell and no layout: the whole
// reply is what is written here. That is deliberate rather than convenient —
// the shell is the sidebar, the live tick and the detail drawer, and every one
// of those is furniture for somebody who is already in. A login screen that
// renders the navigation it is refusing access to is a login screen that leaks
// what the navigation says.
//
// It knows nothing about OAuth. internal/auth's middleware puts a
// model.LoginView on the context — which providers exist, what went wrong last
// time, where the visitor was heading — and this file renders it. So an
// instance with only Google credentials draws one button, an instance with both
// draws two, and an instance with none says so in a sentence instead of
// offering a button that cannot work.

import (
	"net/url"

	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/hushkey-app/guard/internal/telemetry/model"
	"github.com/mirairoad/howl-go/core/router"
	"github.com/mirairoad/howl-go/core/state"
)

templ Page() {
	{{ view := state.Get[model.LoginView](ctx) }}
	<!doctype html>
	<html lang="en" class="dark style-nova">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex"/>
			<title>Sign in — Guard</title>
			<link rel="stylesheet" href={ router.Asset(ctx, "app.css") }/>
		</head>
		<body class="grid min-h-screen place-items-center bg-background p-6 font-sans text-foreground antialiased">
			<main class="w-full max-w-sm">
				<div class="rounded-xl border border-border bg-card p-8 text-card-foreground shadow-2xl">
					<div class="flex flex-col items-center text-center">
						<div class="grid size-11 place-items-center rounded-xl bg-primary text-lg font-black text-primary-foreground">G</div>
						<h1 class="mt-4 text-xl font-semibold tracking-tight">Sign in to Guard</h1>
						<p class="mt-2 text-sm text-muted-foreground">This instance is private. Members sign in with the account their address belongs to.</p>
					</div>
					if view.Error != "" {
						<p role="alert" class="mt-6 rounded-lg border border-destructive/40 bg-destructive/10 p-3 text-sm text-destructive">
							{ view.Error }
						</p>
					}
					if len(view.Providers) > 0 {
						<div class="mt-6 flex flex-col gap-3">
							for _, provider := range view.Providers {
								@button.Button(button.Props{
									Href:    start(provider.ID, view.Next),
									Variant: button.VariantOutline,
									Class:   "w-full justify-center gap-3",
								}) {
									@icon(provider.ID)
									{ provider.Label }
								}
							}
						</div>
						<p class="mt-6 text-center text-xs leading-relaxed text-muted-foreground">
							Signing in proves who you are. Whether you get in is decided by the
							members list — ask an admin to add your address if this is your first time.
						</p>
					} else {
						<p class="mt-6 rounded-lg border border-border bg-muted/40 p-3 text-sm text-muted-foreground">
							No sign-in provider is configured, so this page has nothing to offer.
							Set <code class="font-mono">GUARD_GOOGLE_CLIENT_ID</code> and its secret, or the
							four <code class="font-mono">GUARD_APPLE_*</code> values, and restart guard.
						</p>
					}
				</div>
				<p class="mt-6 text-center text-xs text-muted-foreground">Guard by <span class="font-medium text-foreground">Hushkey</span></p>
			</main>
		</body>
	</html>
}

// start is the URL a button points at, carrying the page the visitor was trying
// to reach so a bookmarked deep link survives the round trip.
func start(provider, next string) string {
	target := "/auth/" + provider + "/start"
	if next != "" {
		target += "?next=" + url.QueryEscape(next)
	}
	return target
}

// The two marks, inline. A dashboard that reaches out to a CDN for a logo on
// its login page is a dashboard that tells someone else every time you sign in.
templ icon(provider string) {
	switch provider {
		case model.ProviderGoogle:
			<svg class="size-4" viewBox="0 0 24 24" aria-hidden="true">
				<path fill="#4285F4" d="M23.5 12.27c0-.79-.07-1.54-.2-2.27H12v4.51h6.47a5.54 5.54 0 0 1-2.4 3.63v3h3.87c2.27-2.09 3.56-5.17 3.56-8.87Z"></path>
				<path fill="#34A853" d="M12 24c3.24 0 5.96-1.08 7.94-2.91l-3.87-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09A12 12 0 0 0 12 24Z"></path>
				<path fill="#FBBC05" d="M5.27 14.29a7.2 7.2 0 0 1 0-4.58V6.62H1.29a12 12 0 0 0 0 10.76l3.98-3.09Z"></path>
				<path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.43-3.43C17.95 1.19 15.24 0 12 0A12 12 0 0 0 1.29 6.62l3.98 3.09C6.22 6.86 8.87 4.75 12 4.75Z"></path>
			</svg>
		case model.ProviderApple:
			<svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M16.36 12.72c-.02-2.4 1.96-3.55 2.05-3.61-1.12-1.63-2.86-1.86-3.48-1.88-1.48-.15-2.89.87-3.64.87-.75 0-1.91-.85-3.14-.83-1.62.02-3.11.94-3.94 2.39-1.68 2.91-.43 7.22 1.2 9.58.8 1.16 1.75 2.45 3 2.4 1.2-.05 1.66-.78 3.11-.78 1.45 0 1.86.78 3.13.75 1.29-.02 2.11-1.17 2.9-2.34.91-1.34 1.29-2.64 1.31-2.71-.03-.01-2.5-.96-2.5-3.84ZM14 5.6c.66-.8 1.11-1.92.99-3.03-.95.04-2.11.63-2.79 1.43-.61.71-1.15 1.85-1.01 2.94 1.06.08 2.15-.54 2.81-1.34Z"></path>
			</svg>
	}
}
