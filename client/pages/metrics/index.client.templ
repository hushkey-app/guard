package metrics

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/hushkey-app/guard/client/lifecycle"
	"github.com/hushkey-app/guard/client/ui"
)

templ Head() {
	<title>Metrics — Guard</title>
	<meta name="description" content="Chart gauges, sums, histograms and summaries received over OTLP."/>
}

templ Page() {
	<section data-signal-page="metrics" class="space-y-6">
		<div class="relative">
			@ui.SignalHeading("Measurements")
			<div class="mt-4 flex items-center gap-2 md:absolute md:right-0 md:top-0 md:mt-0">
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"data-metric-dashboard-edit": true, "aria-pressed": "false"}}) { @ui.Icon("pencil", "size-4")<span data-metric-dashboard-edit-label>Edit</span> }
				<label for="metric-widgets" class="cn-button group/button inline-flex shrink-0 cursor-pointer items-center justify-center gap-2 whitespace-nowrap outline-none select-none cn-button-variant-default cn-button-size-sm [&_svg]:pointer-events-none [&_svg]:shrink-0" title="Add metric">@ui.Icon("plus", "size-4")<span>Add metric</span></label>
			</div>
		</div>
		@ui.FilterBar("metrics")
		<input id="metric-widgets" type="checkbox" class="peer sr-only"/>
		<div data-metric-widget-grid class="grid grid-cols-1 gap-4 lg:grid-cols-12">
			<p data-metric-board-empty class="col-span-full rounded-xl border border-dashed border-border p-8 text-center text-sm text-muted-foreground">Waiting for metric instruments…</p>
		</div>
		<label for="metric-widgets" class="fixed inset-0 z-40 hidden bg-black/55 peer-checked:block" aria-label="Close metric library"></label>
		<aside class="fixed inset-y-0 right-0 z-50 flex w-[min(28rem,92vw)] translate-x-full flex-col border-l border-border bg-background shadow-2xl transition-transform peer-checked:translate-x-0" aria-label="Metric library">
			<div class="flex items-start justify-between gap-4 border-b border-border p-5">
				<div><p class="text-xs font-semibold uppercase tracking-[.2em] text-primary">Metrics</p><h2 class="mt-1 text-xl font-semibold">Metric library</h2><p class="mt-1 text-sm text-muted-foreground">Pin measurements received from the selected service, then arrange your board.</p></div>
				<label for="metric-widgets" class="cursor-pointer rounded-md p-2 text-muted-foreground hover:bg-accent hover:text-foreground" aria-label="Close metric library">@ui.Icon("close", "size-4")</label>
			</div>
			<div data-metric-catalogue class="flex-1 space-y-2 overflow-y-auto p-4"><p class="p-4 text-sm text-muted-foreground">Waiting for metric instruments…</p></div>
			<p class="border-t border-border p-4 text-xs text-muted-foreground">Layout is saved in this browser. Hover or focus a chart for its exact value and timestamp.</p>
		</aside>
	</section>
}

func Mount()   { lifecycle.Mount("metrics") }
func Unmount() { lifecycle.Unmount("metrics") }
