package metrics

import (
	"github.com/axadrn/shadcn-templ/v2/components/badge"
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/table"
	"github.com/hushkey-app/guard/client/lifecycle"
	"github.com/hushkey-app/guard/client/ui"
)

templ Head() {
	<title>Metrics — Guard</title>
	<meta name="description" content="Chart gauges, sums, histograms and summaries received over OTLP."/>
}

templ Page() {
	<section class="space-y-6">
		@ui.PageHeading("Measurements", "Metrics", "Chart gauges, sums, histograms, and summaries; group series by service or instance.")
		@ui.FilterBar("metrics")
		@card.Card() {
			@card.Header() {
				@card.Title() {
					Series
				}
				@card.Action() {
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Attributes: templ.Attributes{"data-metric-series-count": true}}) {
						0 series
					}
				}
			}
			@card.Content() {
				<div data-metric-chart class="min-h-72"></div>
				<div data-metric-legend class="mt-4 flex flex-wrap gap-3"></div>
			}
		}
		<div data-metric-summary class="grid gap-4 md:grid-cols-2 xl:grid-cols-3"></div>
		@card.Card(card.Props{Class: "gap-0 py-0"}) {
			@table.Table() {
				@ui.TableHead([]string{"Time", "Metric", "Service", "Type", "Value", "Attributes"})
				@table.Body(table.BodyProps{Attributes: templ.Attributes{"data-metric-rows": true}})
			}
			@ui.Pagination("metrics")
		}
	</section>
}

func Mount()   { lifecycle.Mount("metrics") }
func Unmount() { lifecycle.Unmount("metrics") }
