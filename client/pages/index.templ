package pages

import (
	"fmt"
	"github.com/mirairoad/guard/client/ui"
	"github.com/mirairoad/guard/internal/telemetry"
)

templ Head() {
	<title>Overview — Guard</title>
	<meta name="description" content="A lightweight OpenTelemetry watchtower for the Hushkies pack."/>
}

templ Page() {
	{{ summary := telemetry.SnapshotFrom(ctx) }}
	<section class="space-y-8">
		<div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
			<div><p class="text-xs font-bold uppercase tracking-[.22em] text-primary">Pack status</p><h1 class="mt-2 text-3xl font-bold tracking-tight md:text-4xl">Everything in sight.</h1><p class="mt-2 max-w-2xl text-base-content/50">Logs, traces, and metrics from every service—one small receiver, no sprawling stack.</p></div>
			<a href="/logs" class="btn btn-primary btn-sm">Inspect live logs →</a>
		</div>
		<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
			@ui.Stat("Instances", "instances", fmt.Sprint(len(summary.Instances)), "active identities")
			@ui.Stat("Logs", "logs", fmt.Sprint(summary.Logs), "retained records")
			@ui.Stat("Errors", "errors", fmt.Sprint(summary.Errors), "need attention")
			@ui.Stat("Spans", "spans", fmt.Sprint(summary.Spans), "trace activity")
			@ui.Stat("Metrics", "metrics", fmt.Sprint(summary.Metrics), "data points")
		</div>
		<div class="grid gap-6 xl:grid-cols-[1fr_1.6fr]">
			<section class="guard-panel rounded-2xl p-5">
				<div class="mb-4 flex items-center justify-between"><h2 class="font-semibold">Instances</h2><span class="badge badge-ghost badge-sm"><span data-stat="instances">{ fmt.Sprint(len(summary.Instances)) }</span>&nbsp;watched</span></div>
				<div class="space-y-2" data-instance-list>
					if len(summary.Instances) == 0 {
						@ui.Empty("Waiting for the first service to report.")
					} else {
						for _, instance := range summary.Instances {
							<div class="flex items-center gap-3 rounded-xl bg-base-100/55 p-3">
								<span class="signal-dot"></span>
								<div class="min-w-0 flex-1"><p class="truncate text-sm font-medium">{ instance.Service }</p><p class="truncate font-mono text-[.65rem] text-base-content/40">{ instance.Instance }</p></div>
								<span class="text-xs text-base-content/40">{ ui.Ago(instance.LastSeen) }</span>
							</div>
						}
					}
				</div>
			</section>
			<section class="guard-panel overflow-hidden rounded-2xl">
				<div class="flex items-center justify-between border-b border-base-300/60 p-5"><h2 class="font-semibold">Recent activity</h2><span class="text-xs text-base-content/40">newest first</span></div>
				if len(summary.Recent) == 0 {
					<div class="p-5" data-recent-empty>@ui.Empty("Telemetry will appear here as it arrives.")</div>
				}
				@ui.EventTable(summary.Recent, "")
			</section>
		</div>
	</section>
}
