package cluster

import (
	"github.com/hushkey-app/guard/client/lifecycle"
	"github.com/hushkey-app/guard/client/ui"
	"github.com/hushkey-app/guard/client/ui/components"
)

templ Head() {
	<title>Cluster — Guard</title>
	<meta name="description" content="Every watched machine: status, uptime, the commands kept for it, and where new machines are declared."/>
}

// One page for the cluster. Declaring a machine and acting on one used to be two
// pages, which meant the answer to "why is VPS-1 down" and the place to fix its
// address were a navigation apart. Settings is configuration now; a machine
// lives here.
//
// The order is the order of the work: what the fleet is doing, then the fleet,
// then how to add to it. Somebody opens this page to look at machines far more
// often than to declare one.
templ Page() {
	<section class="space-y-8">
		@ui.PageHeading("Infrastructure", "Cluster",
			"Every watched machine, with the commands somebody keeps for it ready to run — and where new machines are declared.")
		<div class="space-y-3">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<p class="text-sm text-muted-foreground">Grouped as they are declared. Open one for the commands kept for it.</p>
				@components.MachineDialogOpen("Add or edit machines")
			</div>
			@components.ClusterOps()
			@ui.Note("What counts as up") {
				<p>
					Any answer from 200 to 399 within the timeout. Guard follows up to three redirects,
					reads nothing of the body, and sends no credentials.
				</p>
				<p>
					Change the cadence with <code>GUARD_CLUSTER_INTERVAL</code> and
					<code>GUARD_CLUSTER_TIMEOUT</code>.
				</p>
			}
			@ui.Note("What happens when you run a command") {
				<p>
					A command runs over SSH as the user in the machine's address, only if it was saved
					first, and every run is logged. Running needs a stored login — a machine watched
					without one still shows its status here.
				</p>
				<p>
					A locked machine's commands are frozen: they can be run, and nothing else.
				</p>
			}
		</div>
		@components.ClusterOpsCard()
		<!-- Everything that declares or edits a machine is behind this. The
		     grouped cards above ARE the watched machines, so a second list of
		     them with controls on it said the same thing twice and pushed the
		     fleet below the fold. -->
		@components.MachineDialog()
		@components.ConfirmDialog()
	</section>
}

// Both surfaces on this page are drawn by cluster.js, which dispatches on the
// markup that is present rather than on this name — so the merge needed no
// change there. "cluster" is the name the declaring half already used.
func Mount()   { lifecycle.Mount("cluster") }
func Unmount() { lifecycle.Unmount("cluster") }
