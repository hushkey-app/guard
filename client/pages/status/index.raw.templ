package status

// The public status page.
//
// It is a `.raw` route, and for the same reason /login is one: the shell is the
// sidebar, the live tick and the detail drawer, and every one of those is
// furniture for somebody who is already inside. A status page that renders the
// navigation of the dashboard it sits in front of is a status page that tells
// strangers what the dashboard has in it.
//
// It is rendered on the server, with no JavaScript at all. That is deliberate:
// this is the page people open when something is broken, from a phone, on a
// train, possibly through somebody's corporate proxy — and a page that needs a
// fetch to say "everything is fine" is a page that says nothing when the fetch
// is the thing that is failing. It also means curl, a bot and a screen reader
// all get the same answer.
//
// Everything it can show is model.PublicStatus, which is written out field by
// field rather than filtered from Node. No address, no latency, no status code,
// no error text: the error on a failed check reads "dial tcp 10.19.96.4:5432:
// connect: connection refused", and a status page is a bad place to publish the
// private network.

import (
	"fmt"
	"strconv"
	"time"

	"github.com/hushkey-app/guard/internal/telemetry/model"
	"github.com/mirairoad/howl-go/core/router"
	"github.com/mirairoad/howl-go/core/state"
)

// dayColour is one bar. Absence is not an outage — a day guard was not watching
// is drawn in the muted colour, never in green and never in red, because the
// honest answer to "was it up on the 3rd" for a machine added on the 4th is
// "we do not know".
func dayColour(day model.PublicDay) string {
	switch {
	case day.Checks == 0:
		return "var(--muted)"
	case day.DowntimeSeconds <= 10*60:
		return "var(--success)"
	case day.DowntimeSeconds <= 30*60:
		return "#eab308"
	case day.DowntimeSeconds <= 120*60:
		return "#f97316"
	default:
		return "var(--destructive)"
	}
}

func dayDate(raw string) string {
	at, err := time.Parse("2006-01-02", raw)
	if err != nil {
		return raw
	}
	return at.Format("2 Jan 2006")
}

func incidentMinutes(day model.PublicDay, severity string) int {
	total := 0
	for _, incident := range day.Incidents {
		if incident.Severity == severity {
			total += incident.Minutes
		}
	}
	return total
}

func hasRelated(day model.PublicDay) bool {
	for _, incident := range day.Incidents {
		if incident.Comment != "" {
			return true
		}
	}
	return false
}

func stateColour(state string) string {
	switch state {
	case "operational":
		return "var(--success)"
	case "down":
		return "var(--destructive)"
	case "partial":
		return "var(--warning)"
	default:
		return "var(--muted-foreground)"
	}
}

func stateWords(state string) string {
	switch state {
	case "operational":
		return "All Systems Operational"
	case "down":
		return "Some Systems Are Down"
	case "partial":
		return "Partially Degraded Service"
	default:
		return "No Systems Published"
	}
}

func serviceWords(state string) string {
	switch state {
	case "operational":
		return "Operational"
	case "down":
		return "Down"
	default:
		return "Unknown"
	}
}

templ Page() {
	{{ status := state.Get[model.PublicStatus](ctx) }}
	<!doctype html>
	<html lang="en" class="dark style-nova">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Status</title>
			<link rel="stylesheet" href={ router.Asset(ctx, "app.css") }/>
			<!-- Reloads itself, because the tab somebody left open during an
			     incident is the one that must not be showing yesterday. -->
			<meta http-equiv="refresh" content="60"/>
		</head>
		<body class="min-h-screen bg-background p-6 font-sans text-foreground antialiased">
			<main class="mx-auto w-full max-w-3xl py-8">
					<div class="mb-8 flex items-center gap-3">
						<span class="inline-block size-3 rounded-full" style={ "background:" + stateColour(status.State) }></span>
						<h1 class="text-2xl font-semibold tracking-tight">{ stateWords(status.State) }</h1>
					</div>
					<p class="mb-8 text-sm text-muted-foreground">
						Uptime over the past { strconv.Itoa(status.Days) } days.
					</p>
					if len(status.Services) == 0 {
						<div class="rounded-xl border border-border bg-card p-8 text-center text-card-foreground">
							<p class="text-sm text-muted-foreground">
								Nothing is published yet. A service appears here once its check is
								published from the Checks page.
							</p>
						</div>
					}
					<div class="space-y-6">
						for _, service := range status.Services {
							<section class="rounded-xl border border-border bg-card p-5 text-card-foreground">
								<div class="flex items-baseline justify-between gap-4">
									<h2 class="truncate text-sm font-semibold">{ service.Name }</h2>
									<span class="shrink-0 text-xs font-medium" style={ "color:" + stateColour(service.State) }>
										{ serviceWords(service.State) }
									</span>
								</div>
								<!-- Ninety bars, laid out with inline styles rather than
								     classes: a width or a colour assembled from a value is
								     never emitted by Tailwind, so a class here would be a
								     class that silently does nothing. -->
								<div class="mt-4 flex items-stretch gap-[2px]" style="height:34px">
					for _, day := range service.Days {
						{{ majorMinutes := incidentMinutes(day, "major") }}
						{{ partialMinutes := incidentMinutes(day, "partial") }}
										<div
											class="group relative min-w-[2px] flex-1 rounded-[2px] outline-none focus-visible:ring-2 focus-visible:ring-ring"
											style={ "background:" + dayColour(day) }
											tabindex="0"
											aria-label={ dayDate(day.Date) }
										>
							<div role="tooltip" class="pointer-events-none absolute top-[calc(100%+10px)] left-1/2 z-20 hidden w-80 -translate-x-1/2 rounded-xl border border-border bg-popover p-5 text-popover-foreground shadow-2xl group-first:left-0 group-first:translate-x-0 group-last:right-0 group-last:left-auto group-last:translate-x-0 group-hover:block group-focus:block">
								<p class="text-base font-semibold">{ dayDate(day.Date) }</p>
												if day.Checks == 0 {
													<p class="mt-2 text-xs text-muted-foreground">No data recorded on this day.</p>
												} else if day.DowntimeSeconds == 0 && len(day.Incidents) == 0 {
													<p class="mt-2 text-xs text-muted-foreground">No downtime recorded on this day.</p>
								} else {
									<div class="mt-4 space-y-2">
										if majorMinutes > 0 {
											<div class="grid grid-cols-[auto_1fr_auto_auto] items-center gap-2 rounded-lg bg-muted/50 px-3 py-3">
												<span class="text-base font-bold text-destructive">✕</span>
												<span class="text-sm font-semibold">Major outage</span>
												<span class="font-mono text-sm font-semibold tabular-nums">{ fmt.Sprintf("%d hrs", majorMinutes/60) }</span>
												<span class="font-mono text-sm font-semibold tabular-nums">{ fmt.Sprintf("%d mins", majorMinutes%60) }</span>
											</div>
										}
										if partialMinutes > 0 {
											<div class="grid grid-cols-[auto_1fr_auto_auto] items-center gap-2 rounded-lg bg-muted/50 px-3 py-3">
												<span class="text-base text-warning">▲</span>
												<span class="text-sm font-semibold">Partial outage</span>
												<span class="font-mono text-sm font-semibold tabular-nums">{ fmt.Sprintf("%d hrs", partialMinutes/60) }</span>
												<span class="font-mono text-sm font-semibold tabular-nums">{ fmt.Sprintf("%d mins", partialMinutes%60) }</span>
											</div>
										}
									</div>
									if hasRelated(day) {
										<p class="mt-4 text-[.65rem] font-semibold uppercase tracking-[.14em] text-muted-foreground">Related</p>
										<div class="mt-2 space-y-1.5">
											for _, incident := range day.Incidents {
												if incident.Comment != "" {
													<p class="text-xs leading-relaxed">{ incident.Comment }</p>
												}
											}
										</div>
									} else {
										<p class="mt-4 text-xs leading-relaxed text-muted-foreground">No incidents or maintenance related to this downtime.</p>
									}
								}
											</div>
										</div>
									}
								</div>
								<div class="mt-2 flex items-center justify-between text-[.7rem] text-muted-foreground">
									<span>{ strconv.Itoa(status.Days) } days ago</span>
									if service.Watched {
										<span>{ fmt.Sprintf("%.2f %% uptime", service.Uptime) }</span>
									} else {
										<span>no data yet</span>
									}
									<span>Today</span>
								</div>
							</section>
						}
					</div>
					<footer class="mt-10 flex flex-wrap items-center justify-between gap-3 text-xs text-muted-foreground">
						<a class="underline-offset-4 hover:text-foreground hover:underline" href="/status/past">Incident History</a>
						<span>Updated { status.AsOf.Format("2006-01-02 15:04 UTC") }</span>
						<span>Powered by HUSHKEY</span>
					</footer>
			</main>
		</body>
	</html>
}
