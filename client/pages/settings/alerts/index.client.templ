package alerts

import (
	"github.com/axadrn/shadcn-templ/v2/components/alert"
	"github.com/hushkey-app/guard/client/lifecycle"
	"github.com/hushkey-app/guard/client/ui/components"
)

templ Head() {
	<title>Alerts — Guard</title>
	<meta name="description" content="Where guard sends events, and the rules that decide when."/>
}

templ Page() {
	@components.SettingsShell("/settings/alerts", "Workspace", "Settings", "Manage Guard's storage, configuration, and administrative controls.") {
				<div>
					<p class="text-xs font-semibold uppercase tracking-[.22em] text-primary">Events</p>
					<h2 class="mt-2 text-2xl font-semibold tracking-tight">Alerts</h2>
					<p class="mt-2 text-muted-foreground">
						Guard does not speak any messaging app. What it does is POST one JSON event
						to a URL you name, with a credential if that URL wants one — everything
						between that and a phone is a relay you already have: a Slack hook, an n8n
						flow, a handler that reads <code class="font-mono">message</code>.
					</p>
					<p class="mt-2 text-muted-foreground">
						A rule watches a measurement the cluster page already shows and fires when
						it stays on the wrong side of a line. It says so again when it stops, so
						whatever receives it can close its own incident instead of inferring
						recovery from silence.
					</p>
				</div>
				@components.WebhookList()
				@components.MonitorList()
				@components.ConfirmDialog()
				@alert.Alert() {
					@alert.Title() {
						A machine that cannot answer is silent, never zero
					}
					@alert.Description() {
						CPU, memory, disk and container counts come from the machine itself over
						SSH, so a box with no stored login simply has no reading — a rule about one
						is skipped there rather than treated as 0%. Health, latency and uptime need
						no login. A paused machine is not "down": pausing is what somebody does on
						purpose, and it is the last thing that should page them.
					}
				}
	}
}

func Mount()   { lifecycle.Mount("settings-alerts") }
func Unmount() { lifecycle.Unmount("settings-alerts") }
