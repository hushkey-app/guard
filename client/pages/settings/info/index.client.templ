// Package info is Settings → Info: what this instance is, and the two presses
// that move it to a newer one.
//
// The sidebar's update card answers one question — "is there a newer release" —
// and only when the answer is yes. This page is where the rest of it lives: what
// is running now, what the release channel says, when guard last asked, and what
// `/etc/guard/version` currently pins. A card that appears only when there is
// news is the right shape for a sidebar and the wrong shape for the place you go
// to *check*.
//
// Neither button installs anything, and the page says so rather than implying
// otherwise. Guard writes a version into a file; a root-owned unit on a timer
// verifies a checksum, replaces the binaries and rolls back on a failed health
// check. That separation is the reason the process holding every application's
// secrets is not the process replacing binaries, so the honest word is
// "requested".
package info

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/hushkey-app/guard/client/lifecycle"
	"github.com/hushkey-app/guard/client/ui/components"
)

templ Head() {
	<title>Info — Guard</title>
	<meta name="description" content="What this Guard instance is running, and how to update it."/>
}

templ Page() {
	@components.SettingsShell("/settings/info", "Workspace", "Info", "What this instance is running, and where its releases come from.") {
		<div>
			<p class="text-xs font-semibold uppercase tracking-[.22em] text-primary">This instance</p>
			<h2 class="mt-2 text-2xl font-semibold tracking-tight">Version</h2>
			<p class="mt-2 text-muted-foreground">Guard asks the release repository on its own timer. Check now if you would rather not wait for it.</p>
		</div>
		@card.Card() {
			@card.Content() {
				<dl data-info-version class="grid gap-x-6 gap-y-4 sm:grid-cols-2">
					<div>
						<dt class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Running</dt>
						<dd data-info-current class="mt-1 font-mono text-sm tabular-nums">—</dd>
					</div>
					<div>
						<dt class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Latest release</dt>
						<dd class="mt-1 font-mono text-sm tabular-nums">
							<a data-info-latest href="#" target="_blank" rel="noreferrer noopener" class="hover:underline">—</a>
						</dd>
					</div>
					<div>
						<dt class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Last checked</dt>
						<dd data-info-checked class="mt-1 text-sm text-muted-foreground">never</dd>
					</div>
					<div>
						<dt class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Pinned in /etc/guard/version</dt>
						<dd data-info-wanted class="mt-1 font-mono text-sm tabular-nums text-muted-foreground">—</dd>
					</div>
				</dl>
				<!-- One line that says where this instance stands, filled from the
				     same state the sidebar card reads. Hidden until there is an
				     answer, because "up to date" before the first check is a claim
				     guard has not earned. -->
				<p data-info-summary hidden class="mt-5 border-t border-border pt-5 text-sm"></p>
				<div class="mt-5 flex flex-wrap items-center gap-3 border-t border-border pt-5">
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Attributes: templ.Attributes{"data-info-check": true},
					}) {
						Check for updates
					}
					@button.Button(button.Props{
						Attributes: templ.Attributes{"data-info-update": true, "hidden": true},
					}) {
						Update now
					}
					<span data-info-status class="text-sm text-muted-foreground empty:hidden"></span>
				</div>
				<!-- Not a disclaimer: it is the difference between what this button
				     does and what somebody reasonably assumes it does. -->
				<p class="mt-3 text-xs leading-relaxed text-muted-foreground">
					Update now writes the version into <code class="font-mono">/etc/guard/version</code>. It installs nothing —
					<code class="font-mono">guard-update</code> reads that file on its timer, verifies the download, restarts Guard
					and then the vault, and rolls either back if it does not answer.
				</p>
			}
		}
		<div>
			<p class="text-xs font-semibold uppercase tracking-[.22em] text-primary">This machine</p>
			<h2 class="mt-2 text-2xl font-semibold tracking-tight">Host</h2>
			<p class="mt-2 text-muted-foreground">
				The box Guard is running on, read when this page is opened. Guard samples every machine it watches;
				this is the one it is served from.
			</p>
		</div>
		@card.Card() {
			@card.Content() {
				<!-- Filled by guard.js from /api/info. A field guard could not
				     measure stays a dash rather than becoming a zero: "0% memory
				     used" is a number somebody acts on. -->
				<dl data-info-host class="grid gap-x-6 gap-y-4 sm:grid-cols-2"></dl>
				<p data-info-host-error hidden class="mt-4 text-sm text-muted-foreground"></p>
			}
		}
	}
}

func Mount()   { lifecycle.Mount("info") }
func Unmount() { lifecycle.Unmount("info") }
