package settings

templ Head() { <title>Settings — Guard</title><meta name="description" content="Configure Guard storage and telemetry retention."/> }

templ Page() {
	<section class="mx-auto max-w-3xl space-y-6">
		<div><p class="text-xs font-bold uppercase tracking-[.22em] text-warning">Storage policy</p><h1 class="mt-2 text-3xl font-bold">Settings</h1><p class="mt-2 text-base-content/50">Control how much telemetry Guard keeps in its SQLite database.</p></div>
		<div class="guard-panel rounded-2xl p-5 md:p-6">
			<form data-settings-form class="space-y-5">
				<label class="form-control"><span class="label-text mb-2 font-medium">SQLite database</span><input data-setting="database_path" class="input input-bordered bg-base-100 font-mono text-sm" readonly/><span class="label-text-alt mt-2 text-base-content/45">Set with <code>GUARD_DB_PATH</code> or <code>-db</code>, then mount its directory as a Docker volume.</span></label>
				<div class="grid gap-4 sm:grid-cols-2">
					<label class="form-control"><span class="label-text mb-2 font-medium">Retention</span><div class="join"><input data-setting="retention_hours" type="number" min="1" max="8760" required class="input input-bordered join-item w-full bg-base-100"/><span class="join-item grid place-items-center border border-base-300 bg-base-200 px-4 text-sm">hours</span></div><span class="label-text-alt mt-2 text-base-content/45">Events older than this are removed.</span></label>
					<label class="form-control"><span class="label-text mb-2 font-medium">Maximum events</span><input data-setting="max_events" type="number" min="100" max="100000000" required class="input input-bordered bg-base-100"/><span class="label-text-alt mt-2 text-base-content/45">Oldest events are removed after this limit.</span></label>
				</div>
				<label class="form-control"><span class="label-text mb-2 font-medium">Admin token <span class="font-normal text-base-content/40">(only when GUARD_TOKEN is set)</span></span><input data-setting="token" type="password" autocomplete="off" class="input input-bordered bg-base-100 font-mono" placeholder="Bearer token for saving settings"/><span class="label-text-alt mt-2 text-base-content/45">Kept only in this browser tab; it is never written to SQLite.</span></label>
				<div class="flex flex-wrap items-center gap-3 border-t border-base-300/60 pt-5"><button type="submit" class="btn btn-primary">Save policy</button><button type="button" data-purge-now class="btn btn-ghost">Run cleanup now</button><span data-settings-status class="text-sm text-base-content/50"></span></div>
			</form>
		</div>
		<div class="alert border border-info/20 bg-info/10 text-sm"><span>ⓘ</span><div><div class="font-semibold">Safe Docker path</div><div class="mt-1 text-base-content/60">Use <code>GUARD_DB_PATH=/data/guard.db</code> and mount a named volume at <code>/data</code>. Keep the database and its WAL files on the same local volume.</div></div></div>
	</section>
}
