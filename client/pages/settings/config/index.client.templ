// The configuration page: every environment variable guard reads, as a form.
//
// There is deliberately almost no markup here. One field per variable would be
// forty fields to keep in step with internal/config's catalogue, and the first
// time somebody added a variable and forgot the template, the page would be
// quietly wrong about what guard is configured with. So the groups and the rows
// are drawn by client/public/config.js from what GET /api/config answers, and
// what lives here is the page furniture and the two <template> elements it
// clones — which is how the rest of the dashboard keeps real shadcn markup out
// of JavaScript string concatenation.
package config

import (
	"github.com/axadrn/shadcn-templ/v2/components/alert"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/hushkey-app/guard/client/lifecycle"
	"github.com/hushkey-app/guard/client/ui/components"
)

templ Head() {
	<title>Configuration — Guard</title>
	<meta name="description" content="Every environment variable Guard reads, stored in Guard's own database."/>
}

templ Page() {
	@components.SettingsShell("/settings/config", "Workspace", "Configuration", "Everything Guard reads from the environment, kept where you can change it.") {
				<div>
					<p class="text-xs font-semibold uppercase tracking-[.22em] text-primary">Environment</p>
					<h2 class="mt-2 text-2xl font-semibold tracking-tight">Settings</h2>
					<p class="mt-2 text-muted-foreground">
						A value saved here is stored in Guard's database and put into Guard's environment at the next start — so it outranks the same name in a unit file, and it takes a restart to come into force.
						Who may sign in is on <a href="/settings/security" class="underline">Security</a>.
					</p>
				</div>
				<div data-config-ignored hidden>
					@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
						@alert.Title() {
							Started with GUARD_CONFIG_IGNORE
						}
						@alert.Description() {
							This process is reading the environment alone. Saving still works, and nothing saved will be used until that variable is removed and Guard is restarted.
						}
					}
				</div>
				<div data-config-groups data-config-page="config" class="space-y-6">
					<p data-config-loading class="text-sm text-muted-foreground">Loading…</p>
				</div>
				<div class="sticky bottom-4 flex flex-wrap items-center gap-3 rounded-xl border border-border bg-card/95 p-4 shadow-lg backdrop-blur">
					@button.Button(button.Props{Attributes: templ.Attributes{"data-config-save": true, "type": "button"}}) {
						Save changes
					}
					@button.Button(button.Props{Variant: button.VariantOutline, Attributes: templ.Attributes{"data-config-restart": true, "type": "button", "hidden": true}}) {
						Restart Guard
					}
					<span data-config-status class="text-sm text-muted-foreground"></span>
				</div>
				@alert.Alert() {
					@alert.Title() {
						Two of these cannot be stored here
					}
					@alert.Description() {
						<code class="font-mono">GUARD_DB_PATH</code> and <code class="font-mono">GUARD_SECRET_KEY</code> are what Guard needs to open and decrypt this database, so they cannot live inside it — they are shown read-only, from the environment. Retention and the event cap are on the <a href="/settings" class="underline">Data storage</a> page, because those apply the moment they are saved rather than at the next start.
					}
				}
				@components.ConfirmDialog()
				@components.ConfigTemplates()
	}
}

// group is one titled section of the form. Cloned per group by config.js.
func Mount()   { lifecycle.Mount("settings-config") }
func Unmount() { lifecycle.Unmount("settings-config") }
