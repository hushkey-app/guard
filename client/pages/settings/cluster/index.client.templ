package cluster

import (
	"github.com/axadrn/shadcn-templ/v2/components/alert"
	"github.com/mirairoad/guard/client/lifecycle"
	"github.com/mirairoad/guard/client/ui"
	"github.com/mirairoad/guard/client/ui/components"
)

templ Head() {
	<title>Cluster — Guard</title>
	<meta name="description" content="Watch machines from the outside: a name, a health URL, and what guard saw."/>
}

templ Page() {
	<section class="space-y-8">
		@ui.PageHeading("Workspace", "Settings", "Manage Guard's storage, configuration, and administrative controls.")
		<div class="grid items-start gap-8 lg:grid-cols-[15rem_minmax(0,1fr)]">
			@components.SettingsNav("/settings/cluster")
			<div class="min-w-0 space-y-6">
				<div>
					<p class="text-xs font-semibold uppercase tracking-[.22em] text-primary">Availability</p>
					<h2 class="mt-2 text-2xl font-semibold tracking-tight">Cluster</h2>
					<p class="mt-2 text-muted-foreground">
						Instances are discovered from telemetry, so they vanish when a machine stops
						reporting — the moment you most want to hear about it. A machine listed here is
						watched from the outside, whether or not it is talking to anyone.
					</p>
				</div>
				@components.ClusterForm()
				@components.ClusterList()
				@components.ClusterRow()
				@alert.Alert() {
					@alert.Title() {
						What counts as up
					}
					@alert.Description() {
						Any answer from 200 to 399 within the timeout. Guard follows up to three redirects,
						reads nothing of the body, and sends no credentials. Change the cadence with
						<code class="font-mono">GUARD_CLUSTER_INTERVAL</code> and
						<code class="font-mono">GUARD_CLUSTER_TIMEOUT</code>.
					}
				}
			</div>
		</div>
	</section>
}

func Mount()   { lifecycle.Mount("cluster") }
func Unmount() { lifecycle.Unmount("cluster") }
