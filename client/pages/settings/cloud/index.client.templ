package cloud

import (
	"github.com/axadrn/shadcn-templ/v2/components/alert"
	"github.com/hushkey-app/guard/client/lifecycle"
	"github.com/hushkey-app/guard/client/ui/components"
)

templ Head() {
	<title>Cloud accounts — Guard</title>
	<meta name="description" content="Store one provider API key and use it everywhere: registries, machines, object storage."/>
}

templ Page() {
	@components.SettingsShell("/settings/cloud", "Workspace", "Settings", "Manage Guard's storage, configuration, and administrative controls.") {
				<div>
					<p class="text-xs font-semibold uppercase tracking-[.22em] text-primary">Infrastructure</p>
					<h2 class="mt-2 text-2xl font-semibold tracking-tight">Cloud accounts</h2>
					<p class="mt-2 text-muted-foreground">
						One account API key unlocks everything the provider knows: the container
						registries it owns and their tags, the instances behind the machines on the
						cluster page, and the object storage attached to it. It is one credential at the
						provider, so guard stores it once — typed once, proved once, revoked once.
					</p>
					<p class="mt-2 text-muted-foreground">
						Not every provider answers for all three. Vultr has machines, registries and
						object storage; Cloudflare has R2, and needs its account id beside the token
						because every one of its endpoints hangs off one. Guard reads what each
						provider can do from what it implements, so an account is only ever offered
						the pages it can actually fill.
					</p>
					<p class="mt-2 text-muted-foreground">
						Nothing it unlocks is copied here. Registries, instances and buckets are read
						live on the page that shows them, because a copy of somebody else's state is
						only ever right by coincidence.
					</p>
				</div>
				@components.CloudAccountForm()
				@components.CloudAccountList()
				@components.ConfirmDialog()
				@alert.Alert() {
					@alert.Title() {
						Keys are proved, sealed, and never shown again
					}
					@alert.Description() {
						A key has to answer the provider once before it is stored, so a key that was
						accepted is a key that worked. It is encrypted with <code class="font-mono">GUARD_SECRET_KEY</code> —
						or the key file beside the database when that is unset — and this page is only ever
						told one exists. To rotate a key, remove the account and add it again: the proof
						cannot be skipped that way. Removing an account deletes nothing at the provider,
						but it does unlink every machine that pointed into it.
					}
				}
	}
}

func Mount()   { lifecycle.Mount("settings-cloud") }
func Unmount() { lifecycle.Unmount("settings-cloud") }
