package settings

import (
	"github.com/axadrn/shadcn-templ/v2/components/alert"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	"github.com/hushkey-app/guard/client/lifecycle"
	"github.com/hushkey-app/guard/client/ui"
	"github.com/hushkey-app/guard/client/ui/components"
)

templ Head() {
	<title>Settings — Guard</title>
	<meta name="description" content="Configure Guard storage and telemetry retention."/>
}

templ Page() {
	<section class="space-y-8">
		@ui.PageHeading("Workspace", "Settings", "Manage Guard's storage, configuration, and administrative controls.")
		<div class="grid items-start gap-8 lg:grid-cols-[15rem_minmax(0,1fr)]">
			@components.SettingsNav("/settings")
			<div class="min-w-0 space-y-6">
				<div>
					<p class="text-xs font-semibold uppercase tracking-[.22em] text-primary">Storage policy</p>
					<h2 class="mt-2 text-2xl font-semibold tracking-tight">Data storage</h2>
					<p class="mt-2 text-muted-foreground">Control how much telemetry Guard keeps in its SQLite database.</p>
				</div>
				@card.Card() {
					@card.Content() {
						<form data-settings-form class="space-y-5">
							@field.Field() {
								@field.Label(field.LabelProps{For: "setting-database-path"}) {
									SQLite database
								}
								@input.Input(input.Props{
									ID:         "setting-database-path",
									ReadOnly:   true,
									Class:      "font-mono",
									Attributes: templ.Attributes{"data-setting": "database_path"},
								})
								@field.Description() {
									Set with <code class="font-mono">GUARD_DB_PATH</code> or <code class="font-mono">-db</code>, then mount its directory as a Docker volume.
								}
							}
							<div class="grid gap-4 sm:grid-cols-2">
								@field.Field() {
									@field.Label(field.LabelProps{For: "setting-retention-hours"}) {
										Retention
									}
									<div class="flex items-stretch">
										@input.Input(input.Props{
											ID:         "setting-retention-hours",
											Type:       "number",
											Required:   true,
											Class:      "rounded-r-none",
											Attributes: templ.Attributes{"data-setting": "retention_hours", "min": "1", "max": "8760"},
										})
										<span class="grid place-items-center rounded-r-lg border border-l-0 border-input px-3 text-sm text-muted-foreground">hours</span>
									</div>
									@field.Description() {
										Events older than this are removed.
									}
								}
								@field.Field() {
									@field.Label(field.LabelProps{For: "setting-max-events"}) {
										Maximum events
									}
									@input.Input(input.Props{
										ID:         "setting-max-events",
										Type:       "number",
										Required:   true,
										Attributes: templ.Attributes{"data-setting": "max_events", "min": "100", "max": "100000000"},
									})
									@field.Description() {
										Oldest events are removed after this limit.
									}
								}
							</div>
							@field.Field() {
								@field.Label(field.LabelProps{For: "setting-token"}) {
									Admin token
									<span class="font-normal text-muted-foreground">(only when GUARD_TOKEN is set)</span>
								}
								@input.Input(input.Props{
									ID:          "setting-token",
									Type:        "password",
									Placeholder: "Bearer token for saving settings",
									Class:       "font-mono",
									Attributes:  templ.Attributes{"data-setting": "token", "autocomplete": "off"},
								})
								@field.Description() {
									Kept only in this browser tab; it is never written to SQLite.
								}
							}
							<div class="flex flex-wrap items-center gap-3 border-t border-border pt-5">
								@button.Button(button.Props{Type: button.TypeSubmit}) {
									Save policy
								}
								@button.Button(button.Props{Variant: button.VariantGhost, Attributes: templ.Attributes{"data-purge-now": true}}) {
									Run cleanup now
								}
								<span data-settings-status class="text-sm text-muted-foreground"></span>
							</div>
						</form>
					}
				}
				<div>
					<p class="text-xs font-semibold uppercase tracking-[.22em] text-primary">Access</p>
					<h2 class="mt-2 text-2xl font-semibold tracking-tight">Credentials</h2>
					<p class="mt-2 text-muted-foreground">The two tokens Guard is reached with. Generating one writes it to Guard's own env file; it is in force after a restart.</p>
				</div>
				@card.Card() {
					@card.Content() {
						<div data-access class="space-y-6">
							@credential("token", "Operator token", "GUARD_TOKEN") {
								Opens every write endpoint in the API as well as ingest. This is yours — do not put it on a collector.
							}
							@credential("secret", "Collector secret", "GUARD_OTEL_SECRET") {
								Opens <code class="font-mono">/v1/logs</code>, <code class="font-mono">/v1/traces</code> and <code class="font-mono">/v1/metrics</code> and nothing else. This is the one to hand to a collector on somebody else's box.
							}
							<div class="flex flex-wrap items-center gap-3 border-t border-border pt-5">
								@button.Button(button.Props{Variant: button.VariantOutline, Attributes: templ.Attributes{"data-access-restart": true, "type": "button", "hidden": true}}) {
									Restart Guard
								}
								<span data-access-status class="text-sm text-muted-foreground">Loading…</span>
							</div>
						</div>
					}
				}
				@alert.Alert() {
					@alert.Title() {
						Safe Docker path
					}
					@alert.Description() {
						Use <code class="font-mono">GUARD_DB_PATH=/data/guard.db</code> and mount a named volume at <code class="font-mono">/data</code>. Keep the database and its WAL files on the same local volume.
					}
				}
			</div>
		</div>
	</section>
}

// credential is one row of the access card: the value in the clear, and the
// three things that can be done to it.
//
// In the clear because the whole point of the row is that the value gets
// pasted into a collector's env file on another box — a row of dots is a row
// that sends somebody back to the shell this replaces. The endpoints behind it
// are admin-only, so nobody reads this who could not already read everything.
templ credential(name, label, envName string) {
	@field.Field() {
		@field.Label(field.LabelProps{For: "access-" + name}) {
			{ label }
			<span class="font-mono text-xs font-normal text-muted-foreground">{ envName }</span>
			<span data-access-pending={ name } hidden class="rounded-full border border-border px-2 py-0.5 text-[11px] font-normal text-warning">
				generated · restart to apply
			</span>
		}
		<div class="flex flex-wrap items-stretch gap-2">
			@input.Input(input.Props{
				ID:          "access-" + name,
				ReadOnly:    true,
				Class:       "min-w-[16rem] flex-1 font-mono",
				Placeholder: "not set",
				Attributes:  templ.Attributes{"data-access-value": name, "autocomplete": "off", "spellcheck": "false"},
			})
			@button.Button(button.Props{Variant: button.VariantOutline, Attributes: templ.Attributes{"data-access-copy": name, "type": "button"}}) {
				Copy
			}
			@button.Button(button.Props{Variant: button.VariantOutline, Attributes: templ.Attributes{"data-access-generate": name, "type": "button"}}) {
				Generate
			}
			@button.Button(button.Props{Variant: button.VariantGhost, Attributes: templ.Attributes{"data-access-clear": name, "type": "button"}}) {
				Clear
			}
		</div>
		@field.Description() {
			{ children... }
		}
	}
}

func Mount()   { lifecycle.Mount("settings") }
func Unmount() { lifecycle.Unmount("settings") }
