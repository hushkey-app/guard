package checks

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/hushkey-app/guard/client/lifecycle"
	"github.com/hushkey-app/guard/client/ui"
	"github.com/hushkey-app/guard/client/ui/components"
)

templ Head() {
	<title>Checks — Guard</title>
	<meta name="description" content="HTTP health checks for services, applications and load balancers."/>
}

templ Page() {
	<section class="space-y-8">
		<div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
			@ui.PageHeading("Watch", "Checks", "Health belongs to a service URL, independently of whichever machines sit behind it.")
			<div class="flex shrink-0 flex-wrap items-center gap-2">
				@button.Button(button.Props{Href: "/status", Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"target": "_blank", "rel": "noopener"}}) {
					Preview /status
				}
				@button.Button(button.Props{Type: button.TypeButton, Size: button.SizeSm, Attributes: templ.Attributes{"data-check-open": "new"}}) {
					@ui.Icon("plus", "size-4")
					Add health check
				}
			</div>
		</div>
		@components.HealthCheckList()
		@components.HealthCheckDialog()
	</section>
}

func Mount()   { lifecycle.Mount("checks") }
func Unmount() { lifecycle.Unmount("checks") }
