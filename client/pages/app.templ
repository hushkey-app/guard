package pages

import (
	"strings"

	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/hushkey-app/guard/client/ui"
	"github.com/hushkey-app/guard/client/ui/components"
	"github.com/hushkey-app/guard/internal/build"
	"github.com/hushkey-app/guard/internal/telemetry/model"
	"github.com/mirairoad/howl-go/core/router"
	"github.com/mirairoad/howl-go/core/state"
)

// pageLabel is the document title without the site suffix — the same string
// guard.js derives in updatePageTitle, so the topbar paints its final text
// server-side instead of flashing the full title until JS runs.
func pageLabel(title string) string {
	label, _ := strings.CutSuffix(title, " — Guard")
	return label
}

templ App(title, head string) {
	// 	<a href="/x" data-transition-slide-left>   <!-- one link         -->
	// <html data-transition-fade-up>             <!-- every navigation  -->
	// <a href="/y" data-transition-none>         <!-- opt this one out  -->
	<!doctype html>
	<!-- `style-nova` is not decoration: style-nova.css nests every cn-* rule
	     under it, so shadcn components are unstyled without it on an ancestor.
	     `dark` is what the dark: variants key off. -->
	<html lang="en" class="dark style-nova" data-transition-none>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href={ router.Asset(ctx, "app.css") }/>
			<!-- What the client runtime needs to know about the Go half. Guard
			     renders everything on the server, so this publishes an empty
			     wasm list and no data endpoint — and the client makes no
			     speculative fetch for either. -->
			@templ.JSONScript("howl-client", router.ClientConfig(ctx))
			<script src={ router.Asset(ctx, "app.js") } type="module"></script>
			<script src={ router.Asset(ctx, "guard.js") } type="module"></script>
			<!--page-head-->
			@templ.Raw(head)
			<!--/page-head-->
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<!-- The sidebar is a sibling of this checkbox so `peer-checked:` can
			     reach it: below lg it slides in, from lg it is simply always
			     open. No JavaScript owns the navigation. -->
			<input id="nav-drawer" type="checkbox" class="peer sr-only"/>
			<label for="nav-drawer" aria-hidden="true" class="fixed inset-0 z-30 hidden bg-black/60 peer-checked:block lg:peer-checked:hidden"></label>
			<aside class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col border-r border-sidebar-border bg-sidebar p-4 transition-transform duration-200 peer-checked:translate-x-0 lg:translate-x-0">
				<a href="/" class="mb-7 flex items-center gap-3 px-2 py-1">
					<div class="grid size-9 place-items-center rounded-xl bg-primary text-lg font-black text-primary-foreground">G</div>
					<div>
						<div class="font-semibold tracking-tight">Guard</div>
						<div class="text-[.65rem] uppercase tracking-[.2em] text-muted-foreground">watch the pack</div>
					</div>
				</a>
				<nav class="flex flex-col gap-1">
					for i, group := range ui.NavGroups(router.Nav(router.Routes(ctx))) {
						if i > 0 {
							<div class="mt-2 mb-2 border-t border-sidebar-border"></div>
						}
						for _, route := range group {
							@ui.NavLink(route.Pattern, route.Label)
						}
					}
				</nav>
				<!-- Both cards sit at the bottom, so the space above them belongs to
				     one wrapper: two siblings each carrying mt-auto would split the
				     free space between them and drift apart. -->
				<div class="mt-auto space-y-3">
					@ui.UpdateCard()
					<div class="flex items-center justify-between gap-3 rounded-xl border border-border bg-card p-3 text-xs leading-5 text-muted-foreground">
						<div class="min-w-0">
							<div class="mb-1 font-semibold text-foreground">OTLP/HTTP</div>
							<code class="break-all font-mono">localhost:4318</code>
						</div>
					<!-- Ghost by default, tinted by aria-current: the same reason
					     NavLink works that way — this sits outside #outlet, so a
					     variant chosen at render time would freeze. -->
						@button.Button(button.Props{
							Href:    "/settings",
							Size:    button.SizeIconSm,
							Variant: button.VariantGhost,
							Class:   "aria-[current=page]:bg-primary aria-[current=page]:text-primary-foreground",
							Attributes: templ.Attributes{
								"aria-label":    "Open settings",
								"title":         "Settings",
								"data-nav-link": "true",
								"aria-current":  ui.Current(router.Current(ctx) == "/settings"),
							},
						}) {
							@ui.IconSettings()
						}
					</div>
				</div>
				<!-- Who is looking, when guard has been told to ask. Absent on an
				     instance with no sign-in configured, which is why it is a
				     branch rather than an empty row: there is nobody to name. -->
				{{ viewer := state.Get[model.Viewer](ctx) }}
				if viewer.SignedIn() {
					<div class="mt-3 flex items-center gap-2.5 rounded-xl border border-border bg-card p-3">
						if viewer.Picture != "" {
							<img src={ viewer.Picture } alt="" width="28" height="28" class="size-7 shrink-0 rounded-full object-cover"/>
						} else {
							<div class="grid size-7 shrink-0 place-items-center rounded-full bg-primary/15 text-xs font-semibold text-primary">{ viewer.Initial() }</div>
						}
						<div class="min-w-0 flex-1">
							<div class="truncate text-xs font-medium">{ viewer.Display() }</div>
							<div class="truncate text-[.65rem] text-muted-foreground">{ viewer.Email }</div>
						</div>
						<!-- A form, not a link: signing out changes something, and a
						     GET that changes something is a GET some prefetcher will
						     eventually make for you. -->
						<form method="post" action="/auth/logout">
							@button.Button(button.Props{
								Type:       button.TypeSubmit,
								Variant:    button.VariantGhost,
								Size:       button.SizeIconSm,
								Attributes: templ.Attributes{"aria-label": "Sign out", "title": "Sign out"},
							}) {
								@ui.IconSignOut()
							}
						</form>
					</div>
				}
				<!-- Who made it and which build is answering. The version is the
				     same string the OpenAPI document reports, so a bug report
				     naming what the sidebar says names something real.
				     A release is `v0.1.0`; a local build is what `git describe`
				     said, which is longer and says which commit — so it is
				     truncated with the whole of it on hover rather than
				     shortened here into something that is not the version. -->
				<div class="mt-3 flex items-center justify-between gap-2 px-2 text-[.65rem] text-muted-foreground">
					<span class="shrink-0">Guard by <span class="font-medium text-foreground">Hushkey</span></span>
					<span title={ build.Tag() } class="truncate font-mono tabular-nums">{ build.Tag() }</span>
				</div>
			</aside>
			<div class="flex min-h-screen flex-col lg:pl-64">
				<header class="sticky top-0 z-20 flex h-16 items-center gap-3 border-b border-border bg-background px-4 lg:px-8">
					<label for="nav-drawer" class="grid size-8 cursor-pointer place-items-center rounded-lg border border-border text-muted-foreground hover:text-foreground lg:hidden" aria-label="Open navigation">☰</label>
					<div class="min-w-0 flex-1">
						<p data-page-title class="truncate text-sm font-medium">{ pageLabel(title) }</p>
					</div>
					@button.Button(button.Props{
						Variant:    button.VariantGhost,
						Size:       button.SizeSm,
						Class:      "gap-2",
						Attributes: templ.Attributes{"data-live-toggle": true, "aria-label": "Pause live refresh"},
					}) {
						<span class="signal-dot" data-live-dot></span>
						<span data-live-status>connecting</span>
						<span data-live-action class="text-muted-foreground">Pause</span>
					}
				</header>
				<main id="outlet" data-route={ router.Current(ctx) } class="mx-auto w-full max-w-[96rem] p-4 lg:p-8">{ children... }</main>
			</div>
			<!-- Row detail. Present on every page because guard.js fills it from
			     whichever table was clicked; closed it is off-canvas and inert. -->
			<div data-detail-shell class="fixed inset-0 z-50">
				<button type="button" data-detail-close aria-label="Close details" class="absolute inset-0 bg-black/60 transition-opacity"></button>
				<aside data-detail-panel class="pointer-events-auto absolute inset-y-0 right-0 flex w-full max-w-xl flex-col border-l border-border bg-card text-card-foreground shadow-2xl transition-transform duration-200">
					<div class="flex items-center justify-between gap-4 border-b border-border p-5">
						<div class="min-w-0">
							<p data-detail-eyebrow class="text-xs font-semibold uppercase tracking-[.18em] text-primary">Telemetry detail</p>
							<h2 data-detail-title class="mt-1 truncate text-xl font-semibold">Event</h2>
						</div>
						@button.Button(button.Props{
							Variant:    button.VariantGhost,
							Size:       button.SizeIconSm,
							Attributes: templ.Attributes{"data-detail-close": true, "aria-label": "Close details"},
						}) {
							✕
						}
					</div>
					<div data-detail-content class="flex-1 space-y-6 overflow-y-auto p-5"></div>
					<!-- Shown when the drawer is listing what is behind a mark
					     rather than one event: the way back to the chart. -->
					<div data-detail-footer hidden class="border-t border-border p-4">
						@button.Button(button.Props{
							Variant:    button.VariantOutline,
							Size:       button.SizeSm,
							Class:      "w-full",
							Attributes: templ.Attributes{"data-detail-back": true},
						}) {
							← Back to the list
						}
					</div>
				</aside>
			</div>
			<!-- Chart furniture that outlives a navigation, next to the drawer
			     it feeds: every page draws, so every page needs these. -->
			@components.Tooltip()
			@components.DrillRow()
		</body>
	</html>
}

templ NotFound(path string) {
	<section class="grid min-h-[60vh] place-items-center text-center">
		<div>
			<p class="text-7xl font-black text-primary">404</p>
			<h1 class="mt-4 text-2xl font-semibold">Nothing on watch here</h1>
			<p class="mt-2 text-muted-foreground">No route at <code class="font-mono">{ path }</code>.</p>
			@button.Button(button.Props{Href: "/", Size: button.SizeSm, Class: "mt-6"}) {
				Back to overview
			}
		</div>
	</section>
}
