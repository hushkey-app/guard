package pages

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/hushkey-app/guard/client/ui/components"
	"github.com/mirairoad/howl-go/core/router"
)

templ App(title, head string) {
	// 	<a href="/x" data-transition-slide-left>   <!-- one link         -->
	// <html data-transition-fade-up>             <!-- every navigation  -->
	// <a href="/y" data-transition-none>         <!-- opt this one out  -->
	<!doctype html>
	<!-- `style-nova` is not decoration: style-nova.css nests every cn-* rule
	     under it, so shadcn components are unstyled without it on an ancestor.
	     `dark` is what the dark: variants key off. -->
	<html lang="en" class="dark style-nova" data-transition-none>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href={ router.Asset(ctx, "app.css") }/>
			<!-- What the client runtime needs to know about the Go half. Guard
			     renders everything on the server, so this publishes an empty
			     wasm list and no data endpoint — and the client makes no
			     speculative fetch for either. -->
			@templ.JSONScript("howl-client", router.ClientConfig(ctx))
			<script src={ router.Asset(ctx, "app.js") } type="module"></script>
			<script src={ router.Asset(ctx, "guard.js") } type="module"></script>
			<!--page-head-->
			@templ.Raw(head)
			<!--/page-head-->
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<!-- The document shell, and nothing that depends on the route.
			     A client-side navigation swaps #outlet and only #outlet, so
			     anything route-dependent parked here would freeze on whichever
			     page was loaded first. The sidebar and the content frame moved
			     to client/pages/layout.templ for exactly that reason; what is
			     left below is furniture that is deliberately outside the outlet
			     because it must outlive a navigation. -->
			<main id="outlet" data-route={ router.Current(ctx) }>{ children... }</main>
			<!-- Global detail remains available to logs, metrics, and chart
			     drills. Traces own a second, nested copy inside their timeline. -->
			<div class="fixed inset-0 z-50 pointer-events-none">
				@components.DetailDrawer("global", true)
			</div>
			<!-- Chart furniture that outlives a navigation, next to the drawer
			     it feeds: every page draws, so every page needs these. -->
			@components.Tooltip()
			@components.DrillRow()
		</body>
	</html>
}

templ NotFound(path string) {
	<section class="grid min-h-[60vh] place-items-center text-center">
		<div>
			<p class="text-7xl font-black text-primary">404</p>
			<h1 class="mt-4 text-2xl font-semibold">Nothing on watch here</h1>
			<p class="mt-2 text-muted-foreground">No route at <code class="font-mono">{ path }</code>.</p>
			@button.Button(button.Props{Href: "/", Size: button.SizeSm, Class: "mt-6"}) {
				Back to overview
			}
		</div>
	</section>
}
