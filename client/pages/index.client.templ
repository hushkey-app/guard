package pages

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/hushkey-app/guard/client/lifecycle"
	"github.com/hushkey-app/guard/client/ui"
	"github.com/hushkey-app/guard/client/ui/components"
)

templ Head() {
	<title>Overview — Guard</title>
	<meta name="description" content="A lightweight OpenTelemetry watchtower for the Hushkies pack."/>
}

templ Page() {
	<section class="space-y-6">
		<div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
			<div>
				<p class="text-xs font-semibold uppercase tracking-[.22em] text-primary">Status</p>
				<h1 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">Everything in sight.</h1>
				<p class="mt-2 max-w-2xl text-muted-foreground">Logs, traces, and metrics from every service—one small receiver, no sprawling stack.</p>
			</div>
			<div class="flex items-center gap-2">
				@button.Button(button.Props{Href: "/logs", Variant: button.VariantOutline, Size: button.SizeSm}) { Inspect live logs → }
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"data-dashboard-edit": true, "aria-pressed": "false"}}) { @ui.Icon("pencil", "size-4")<span data-dashboard-edit-label>Edit</span> }
				<label for="dashboard-widgets" class="cn-button group/button inline-flex shrink-0 cursor-pointer items-center justify-center gap-2 whitespace-nowrap outline-none select-none cn-button-variant-default cn-button-size-sm [&_svg]:pointer-events-none [&_svg]:shrink-0" title="Add widget">@ui.Icon("plus", "size-4")<span>Add widget</span></label>
			</div>
		</div>
		@components.OverviewWidgets()
		// What runs where. An instance is discovered from telemetry and a node
		// is declared, and the two are joined on the hosts the telemetry names —
		// so a machine that stops reporting keeps its place here and goes red,
		// instead of quietly vanishing from a flat list.
		@components.TopologyGroup()
		@components.TopologyInstance()
	</section>
}

func Mount()   { lifecycle.Mount("home") }
func Unmount() { lifecycle.Unmount("home") }
