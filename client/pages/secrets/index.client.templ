package secrets

import (
	"github.com/axadrn/shadcn-templ/v2/components/alert"
	"github.com/hushkey-app/guard/client/lifecycle"
	"github.com/hushkey-app/guard/client/ui"
	"github.com/hushkey-app/guard/client/ui/components"
)

templ Head() {
	<title>Secrets — Guard</title>
	<meta name="description" content="The environment variables your applications boot with, encrypted at rest and served by guard-vault."/>
}

templ Page() {
	<section class="space-y-8">
		<div class="relative">
			@ui.SignalHeading("Secrets")
			<div class="mt-4 flex flex-wrap items-center gap-2 md:absolute md:right-0 md:top-0 md:mt-0">
				@components.SecretActions()
			</div>
		</div>
		@components.SecretsPanel()
		@components.ConfirmDialog()
		@alert.Alert() {
			@alert.Title() {
				This page writes; guard-vault serves
			}
			@alert.Description() {
				Applications never read secrets from guard. They hold a key and ask
				<code class="font-mono">guard-vault</code>, a second binary on this same database
				and key file, so a bad dashboard release cannot stop a container from booting —
				and the environment a key may read comes from the key itself, never from the
				request, so a staging token cannot be pointed at production by editing a URL.
				A key is shown once and stored as a hash; revoking one takes effect on the very
				next fetch, because the vault looks it up every time.
			}
		}
	</section>
}

func Mount()   { lifecycle.Mount("secrets") }
func Unmount() { lifecycle.Unmount("secrets") }
