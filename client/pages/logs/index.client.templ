package logs

import (
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/table"
	"github.com/hushkey-app/guard/client/lifecycle"
	"github.com/hushkey-app/guard/client/ui"
	"github.com/hushkey-app/guard/client/ui/components"
)

templ Head() {
	<title>Logs — Guard</title>
	<meta name="description" content="Search live logs received over OTLP or JSON."/>
}

templ Page() {
	<section data-signal-page="logs" class="space-y-6">
		@ui.SignalHeading("Live tail")
		@ui.FilterBar("logs")
		@components.LogCard()
		@components.SpanRow()
		@card.Card(card.Props{Class: "gap-0 py-0", Attributes: templ.Attributes{"data-signal-list": true}}) {
			@table.Table() {
				@ui.TableHead([]string{"Time", "Severity", "Service", "Message"})
				@table.Body(table.BodyProps{Attributes: templ.Attributes{"data-log-rows": true}})
			}
			@ui.Pagination("logs")
		}
	</section>
}

func Mount()   { lifecycle.Mount("logs") }
func Unmount() { lifecycle.Unmount("logs") }
