package logs

import (
	"fmt"
	"github.com/mirairoad/guard/client/ui"
	"github.com/mirairoad/guard/internal/telemetry"
)

templ Head() { <title>Logs — Guard</title><meta name="description" content="Search live logs received over OTLP or JSON."/> }

templ Page() {
	{{ summary := telemetry.SnapshotFrom(ctx) }}
	<section class="space-y-6">
		<div><p class="text-xs font-bold uppercase tracking-[.22em] text-primary">Live tail</p><h1 class="mt-2 text-3xl font-bold">Logs</h1><p class="mt-2 text-base-content/50">Filter retained logs, pause the live stream, and open any row for complete context.</p></div>
		@ui.FilterBar("logs")
		<div class="guard-panel overflow-hidden rounded-2xl">
			<div class="overflow-x-auto">
				<table class="table table-sm">
					<thead><tr><th>Time</th><th>Severity</th><th>Service</th><th>Message</th><th>Trace</th></tr></thead>
					<tbody data-log-rows>
						for _, event := range summary.Recent {
							if event.Signal == "logs" {
								<tr class="event-row cursor-pointer" data-event-id={ fmt.Sprint(event.ID) } tabindex="0"><td class="font-mono text-xs">{ event.Timestamp.Local().Format("15:04:05.000") }</td><td class="font-mono text-xs">{ event.Severity }</td><td>{ event.Service }</td><td class="max-w-xl truncate">{ event.Message }</td><td class="font-mono text-[.65rem] text-base-content/40">{ event.TraceID }</td></tr>
							}
						}
					</tbody>
				</table>
			</div>
		</div>
	</section>
}
