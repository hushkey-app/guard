[Unit]
Description=guard — telemetry, cluster and the secrets dashboard
After=network-online.target
Wants=network-online.target

[Service]
# GUARD_OTEL_SECRET, GUARD_TOKEN, the OAuth credentials — everything that is a
# credential rather than a path. The leading dash makes it optional, so a box
# with no secrets to set still starts. systemd reads it as root before dropping
# to the guard user, which is why the file is root-owned 0600 and readable by
# nothing else, even though /etc/guard is otherwise the guard user's to write.
EnvironmentFile=-/etc/guard/guard.env
# Kept for boxes provisioned before guard's configuration moved into its
# database. Guard no longer writes this file; a value it once generated here is
# now simply part of the environment, and anything saved from Settings →
# Configuration outranks it at the next start.
EnvironmentFile=-/etc/guard/env.d/tokens.env
ExecStart=/usr/local/bin/guard -db /var/lib/guard/guard.db
User=guard
Restart=always
RestartSec=2
# It writes the database, its WAL and the key file beside them — and
# /etc/guard/version, which is the one thing the dashboard's Update button
# does. Guard's own settings live in the database, not in a file here.
# Installing is guard-update's job, running as root on a timer; guard only
# writes down which version is wanted, which is why this is the whole extent of
# what it may touch outside its own data directory.
ProtectSystem=strict
ReadWritePaths=/var/lib/guard /etc/guard
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
