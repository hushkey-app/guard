[Unit]
Description=check for a new guard release

[Timer]
# Every fifteen minutes, spread so a fleet does not ask GitHub in lockstep.
# Unauthenticated API calls are limited to 60 an hour per address, and four an
# hour per box leaves room for a good few boxes behind one NAT.
OnBootSec=2min
OnUnitActiveSec=15min
RandomizedDelaySec=2min
# No Persistent= here, because it would be decoration: it only catches up missed
# OnCalendar= elapses, and both triggers above are monotonic. A box that was off
# runs two minutes after it comes back, which is the behaviour Persistent= would
# have been asked for anyway.

[Install]
# Enable this with --now. Enabling alone takes effect at the next boot, and a
# provisioning script that reaches this line after timers.target — which is
# every provisioning script — leaves the box never checking for a release.
WantedBy=timers.target
